---
/** Over Scott — kort, menselijk, één (placeholder-)foto. */
import { site } from '../data/site';
import { content } from '../data/content';
const { about } = content(Astro.currentLocale);
---

<section class="bg-cream py-16 text-ink sm:py-24" id="about" data-reveal-section>
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 md:grid-cols-[300px_minmax(0,1fr)]">
    {/* De foto staat in dezelfde 3:4-verhouding als het bestand zelf, dus
        object-cover snijdt er niets af. bg-ink blijft staan als achtergrond
        zolang de afbeelding nog laadt. */}
    <div
      class="mx-auto aspect-[3/4] w-56 overflow-hidden rounded-2xl bg-ink shadow-card-lg md:w-full"
      data-reveal
    >
      <img
        src="/scott-800.webp"
        srcset="/scott-400.webp 400w, /scott-800.webp 800w"
        sizes="(min-width: 768px) 300px, 14rem"
        width="800"
        height="1067"
        alt={about.photoAlt}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>

    <div data-reveal>
      <p class="kicker">{about.kicker}</p>
      <h2 class="font-display text-h2 mt-2 font-semibold text-balance">{about.title}</h2>
      {about.paragraphs.map((p) => <p class="text-muted mt-4 leading-relaxed">{p}</p>)}
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={`https://wa.me/${site.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
        >
          {about.whatsappButton}
        </a>
        <a
          href={`mailto:${site.email}`}
          class="rounded-xl border border-line px-5 py-3 text-sm font-semibold transition-colors hover:border-accent"
        >
          ✉️ {site.email}
        </a>
      </div>
    </div>
  </div>
</section>
