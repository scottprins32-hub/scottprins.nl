---
/**
 * Over Scott. Echte foto, echte cijfers (die Scott zelf onderschrijft) en
 * twee sites waar je zelf doorheen kunt klikken. Geen verzonnen klanten.
 */
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { content, toLocale } from '../data/content';
import Icon from './Icon.astro';
import scott from '../assets/img/scott.webp';

const { about } = content(toLocale(Astro.currentLocale));
---

<section class="about section-pad" aria-labelledby="about-title">
  <div class="wrap about-grid">
    <figure class="about-photo" data-photo>
      <Image src={scott} alt={about.photoAlt} widths={[400, 640, 800]} sizes="(min-width: 1024px) 36vw, 90vw" />
    </figure>
    <div class="about-copy">
      <p class="label about-label">{about.label}</p>
      <h2 id="about-title" class="display about-title" data-reveal="title">{about.title}</h2>
      {
        about.paragraphs.map((paragraph) => (
          <p class="lead about-text" data-reveal="up">
            {paragraph}
          </p>
        ))
      }

      <dl class="about-stats" data-reveal="up">
        {
          about.stats.map((stat) => (
            <div class="about-stat">
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))
        }
      </dl>

      <h3 class="label about-proof-label">{about.proofLabel}</h3>
      <ul class="about-proof">
        {
          about.proof.map((item) => {
            const external = item.href.startsWith('http');
            return (
              <li data-reveal="up">
                <a href={item.href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
                  <span class="about-proof-name">
                    {item.name}
                    <Icon name={external ? 'arrow-up-right' : 'arrow-right'} />
                    {external && <span class="sr-only">({about.newTab})</span>}
                  </span>
                  <span class="about-proof-text">{item.text}</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <a class="btn btn-ghost about-wa" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
        <Icon name="whatsapp" />{about.whatsapp}
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap, OK } from '../scripts/motion/core';
  const photo = document.querySelector<HTMLElement>('[data-photo]');
  if (photo) {
    gsap.matchMedia().add(OK, () => {
      gsap.fromTo(
        photo,
        { clipPath: 'inset(100% 0% 0% 0%)' },
        {
          clipPath: 'inset(0% 0% 0% 0%)',
          duration: 1.4,
          ease: 'expo.inOut',
          scrollTrigger: { trigger: photo, start: 'top 80%', once: true },
        },
      );
      gsap.fromTo(
        photo.querySelector('img'),
        { scale: 1.25 },
        { scale: 1, duration: 1.8, ease: 'expo.out', scrollTrigger: { trigger: photo, start: 'top 80%', once: true } },
      );
    });
  }
</script>

<style>
  .about {
    border-top: 1px solid var(--color-line);
  }
  .about-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 2vw, 2rem);
  }
  .about-photo,
  .about-copy {
    grid-column: 1 / -1;
  }
  .about-photo {
    margin: 0;
    max-width: 26rem;
    overflow: hidden;
    border-radius: 0.875rem;
    aspect-ratio: 3 / 4;
  }
  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-label {
    margin: 0 0 1.25rem;
    color: var(--color-mute);
  }
  .about-title {
    margin: 0 0 1.75rem;
    font-size: var(--text-display-l);
  }
  .about-text {
    max-width: 36rem;
    margin: 0 0 1rem;
    color: var(--color-bone-2);
  }
  .about-stats {
    display: grid;
    grid-template-columns: 1fr;
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--color-line);
  }
  .about-stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .about-stat dd {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 760;
    font-stretch: 116%;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .about-stat dt {
    font-size: 0.9375rem;
    color: var(--color-mute);
  }
  .about-proof-label {
    margin: 3rem 0 0.5rem;
    color: var(--color-mute);
  }
  .about-proof {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-proof a {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
  }
  .about-proof-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.35rem;
    font-weight: 680;
    font-stretch: 110%;
    letter-spacing: -0.02em;
  }
  .about-proof-name :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-signal-text);
    transition: transform 0.35s var(--ease-out-quart);
  }
  .about-proof a:hover .about-proof-name :global(.icon) {
    transform: translate(3px, -3px);
  }
  .about-proof-text {
    color: var(--color-bone-2);
  }
  .about-wa {
    margin-top: 2.5rem;
  }
  @media (min-width: 40rem) {
    .about-stats {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 1.5rem;
    }
  }
  @media (min-width: 64rem) {
    .about-photo {
      grid-column: 1 / span 5;
      align-self: start;
      position: sticky;
      top: 7rem;
      max-width: none;
    }
    .about-copy {
      grid-column: 7 / -1;
    }
  }
</style>
