---
/**
 * De "site-in-aanbouw"-scène: een mini-scottprins.nl, opgebouwd uit
 * HERKENBARE stukjes van de echte site (kopregel, prijskaart, chatbot,
 * review, stat-tegel, agenda-slots, cart-pill) — met echte teksten en
 * echte prijzen uit pricing.ts, dus altijd in sync.
 *
 * De scène is een échte 3D-opstelling: `.scene` heeft preserve-3d en elk
 * stuk krijgt een eigen `--z` (diepte). Bij het laden zweven de stukken
 * los vóór en achter het scherm in een gekantelde "exploded view"; tijdens
 * het scrollen draait de camera vlak en klikken de stukken op hun plek.
 *
 * Alle maten in cqw (container query units): de scène schaalt verliesvrij,
 * van de grote hero tot het kleine demo-11-kaartje.
 *
 * De DEFAULT-toestand (zonder JS) is "afgebouwd en vlak": dat is wat
 * bezoekers zonder JavaScript of met reduced motion zien.
 */
import { addons } from '../data/pricing';
import { demoReviews } from '../data/site';
import { priceLine } from '../lib/format';

const agenda = addons.find((a) => a.id === 'agenda')!;
const review = demoReviews.reviews[1];

interface Props {
  /** Interactieve mini-knop (alleen in de hero). */
  interactive?: boolean;
}
const { interactive = false } = Astro.props;
---

<div class="scene-stage relative w-full" data-scene-root>
  {/* Twee geneste 3D-lagen: de camera volgt de muis, de scène volgt het
      scrollen. Zo vechten die twee rotaties nooit om hetzelfde element. */}
  <div class="scene-camera" data-scene-camera>
    <div class="scene relative mx-auto w-[94%]" data-scene>
    {/* Vlak achter de site: vangt de gloed op en geeft de scène bodem */}
    <span class="scene-floor pointer-events-none absolute inset-0" data-floor aria-hidden="true"></span>

    <div class="scene-frame relative aspect-[4/3] overflow-hidden rounded-[2cqw] bg-ink" data-piece="frame" style="--z: 0">
      {/* Browserchrome */}
      <div class="relative z-10 flex items-center gap-[1.6cqw] border-b border-cream/15 px-[2cqw] py-[1.1cqw]">
        <span class="flex gap-[0.7cqw]" aria-hidden="true">
          <span class="h-[1cqw] w-[1cqw] rounded-full bg-cream/40"></span>
          <span class="h-[1cqw] w-[1cqw] rounded-full bg-cream/40"></span>
          <span class="h-[1cqw] w-[1cqw] rounded-full bg-accent" data-pop></span>
        </span>
        <span class="rounded-full bg-white/10 px-[2cqw] py-[0.5cqw] font-medium text-cream/80 text-[1.5cqw]">
          scottprins.nl
        </span>
      </div>

      {/* Lichte zone onderin: de "menukaart" van de mini-site */}
      <div class="absolute inset-x-0 top-[49%] bottom-0 bg-cream" data-menu-zone>
        <p class="kicker absolute top-[3%] left-[4.5%] text-[1.4cqw]!">De menukaart</p>
      </div>

      {/* Schetslijnen (Dag 1) */}
      {
        [
          'top-[13.5%] left-[4.5%] h-[19%] w-[52%]',
          'top-[12%] right-[4%] h-[26%] w-[35%]',
          'top-[56%] left-[4.5%] h-[30%] w-[91.5%]',
          'bottom-[4%] left-[32%] h-[7%] w-[36%]',
        ].map((pos) => (
          <span
            class:list={['absolute rounded-[1.4cqw] border-[0.3cqw] border-dashed border-accent/45', pos]}
            data-sketch
            aria-hidden="true"
          />
        ))
      }
    </div>

    {/* ---------- De losse stukken: elk een eigen 3D-laag ---------- */}

    {/* Kopregel van de mini-site */}
    <div class="piece absolute top-[12.5%] left-[7.2%] w-[50%]" data-piece="headline" style="--z: 90px">
      {/* Bewust NIET dezelfde zin als de H1 van de pagina: op een telefoon
          staan die twee vlak onder elkaar en las je 'm anders dubbel. */}
      <p class="font-display font-semibold text-cream text-[5cqw] leading-[1.05]">Jouw website.</p>
      <p class="mt-[1cqw] text-muted-dark text-[2cqw]">Kies je basis, kies je extra’s.</p>
    </div>

    {/* CTA-knop */}
    <span
      class="piece absolute top-[34.5%] left-[7.2%] inline-block rounded-full bg-accent px-[2.6cqw] py-[1.1cqw] font-semibold text-white text-[1.9cqw] shadow-[0_1cqw_3cqw_-0.5cqw_var(--accent)]"
      data-piece="cta"
      style="--z: 150px"
    >
      Stel je website samen
    </span>

    {/* AI-chatbot (optie 2) */}
    <div
      class="piece absolute top-[12%] right-[6.5%] w-[33%] overflow-hidden rounded-[1.6cqw] bg-white"
      data-piece="chat"
      style="--z: 190px"
    >
      <div class="flex items-center gap-[1cqw] border-b border-line px-[1.6cqw] py-[1cqw]">
        <span class="flex h-[3cqw] w-[3cqw] items-center justify-center rounded-full bg-accent text-[1.6cqw]">💬</span>
        <span class="font-semibold text-ink text-[1.7cqw]">Salon Demo</span>
        <span class="ml-auto h-[1.2cqw] w-[1.2cqw] rounded-full bg-green-500" data-pop></span>
      </div>
      <div class="grid gap-[1cqw] p-[1.4cqw]">
        <p class="w-fit max-w-[88%] rounded-[1.2cqw] rounded-bl-[0.3cqw] bg-cream-dim p-[1.2cqw] text-ink text-[1.55cqw] leading-snug">
          Hoi! Vraag me iets over openingstijden of prijzen 💇
        </p>
        <p class="ml-auto w-fit max-w-[88%] rounded-[1.2cqw] rounded-br-[0.3cqw] bg-accent p-[1.2cqw] text-white text-[1.55cqw] leading-snug">
          Kan ik vandaag nog terecht?
        </p>
      </div>
    </div>

    {/* Prijskaart (echte prijs uit pricing.ts) */}
    <div
      class="piece absolute top-[56%] left-[7.2%] w-[27%] rounded-[1.4cqw] bg-white p-[1.7cqw]"
      data-piece="pricecard"
      style="--z: 120px"
    >
      <span class="flex flex-wrap items-center gap-[0.8cqw]">
        <span class="font-display font-semibold text-ink text-[1.9cqw]">{agenda.name}</span>
        <span class="badge-populair px-[1cqw]! py-[0.3cqw]! text-[1.2cqw]!" data-pop>Populair</span>
      </span>
      <p class="mt-[0.8cqw] font-semibold text-ink text-[1.7cqw]">{priceLine(agenda.upfront, agenda.monthly)}</p>
      {
        interactive ? (
          <button
            type="button"
            class="mini-cta mt-[1.2cqw] block w-full rounded-[1cqw] border-[0.25cqw] border-accent py-[0.7cqw] text-center font-semibold text-accent text-[1.5cqw] transition-colors hover:bg-accent hover:text-white"
            data-scene-add
          >
            + In mijn website
          </button>
        ) : (
          <span class="mt-[1.2cqw] block rounded-[1cqw] border-[0.25cqw] border-accent py-[0.7cqw] text-center font-semibold text-accent text-[1.5cqw]">
            + In mijn website
          </span>
        )
      }
    </div>

    {/* Google-review (optie 6) */}
    <div
      class="piece absolute top-[56%] left-[36.5%] w-[27%] rounded-[1.4cqw] bg-white p-[1.7cqw]"
      data-piece="review"
      style="--z: 60px"
    >
      <span class="flex items-center gap-[1cqw]">
        <span class="flex h-[2.8cqw] w-[2.8cqw] items-center justify-center rounded-full bg-accent/10 font-semibold text-accent text-[1.5cqw]">
          {review.name[0]}
        </span>
        <span class="font-semibold text-ink text-[1.5cqw]">{review.name}</span>
        <span class="ml-auto font-bold text-[#4285F4] text-[1.8cqw]">G</span>
      </span>
      <p class="mt-[0.7cqw] tracking-tight text-amber-500 text-[1.7cqw]" data-pop>★★★★★</p>
      <p class="mt-[0.6cqw] text-muted text-[1.4cqw] leading-snug">{review.text.slice(0, 76)}…</p>
    </div>

    {/* Stat-tegel (uit de proof-sectie) */}
    <div
      class="piece absolute top-[56%] right-[6.5%] w-[25%] rounded-[1.4cqw] bg-ink p-[1.7cqw] text-center ring-1 ring-white/10"
      data-piece="stat"
      style="--z: 100px"
    >
      <p class="font-display font-semibold text-cream text-[3.4cqw]">
        <span class="text-accent-soft" data-pop>5</span> dagen
      </p>
      <p class="mt-[0.5cqw] text-muted-dark text-[1.4cqw]">gem. oplevertijd</p>
    </div>

    {/* Agenda-tijdsloten (optie 1) */}
    <div class="piece absolute bottom-[6%] left-[7.2%] flex gap-[1cqw]" data-piece="chips" style="--z: 70px">
      {
        ['09:00', '10:30', '14:00', '15:30'].map((slot, i) => (
          <span
            class:list={[
              'rounded-full border-[0.2cqw] px-[1.6cqw] py-[0.6cqw] font-medium tabular-nums text-[1.5cqw]',
              i === 1 ? 'border-accent bg-accent text-white' : 'border-line bg-white text-ink',
            ]}
            data-pop={i === 1 ? true : undefined}
          >
            {slot}
          </span>
        ))
      }
    </div>

    {/* Cart-pill: het bekendste element van de site */}
    <span
      class="piece absolute bottom-[6%] left-[59%] flex w-max items-center gap-[1cqw] rounded-full bg-ink py-[1cqw] pr-[2cqw] pl-[1.2cqw] font-semibold text-cream text-[1.6cqw] ring-1 ring-white/20"
      data-piece="pill"
      style="--z: 210px"
    >
      <span class="flex h-[2.4cqw] w-[2.4cqw] items-center justify-center rounded-full bg-accent text-white text-[1.4cqw]">1</span>
      optie · {priceLine(agenda.upfront, agenda.monthly)}
    </span>

    {/* Gloed rond het afgebouwde resultaat (Dag 5 — live) */}
    <span class="scene-glow pointer-events-none absolute inset-0 rounded-[2cqw]" data-glow aria-hidden="true"></span>

    {/* Sterretjes (Dag 5) */}
    {
      [
        ['-left-[3%]', 'top-[8%]'],
        ['-right-[2%]', 'top-[26%]'],
        ['left-[2%]', '-bottom-[4%]'],
        ['right-[6%]', '-bottom-[3%]'],
      ].map(([x, y]) => (
        <span
          class:list={['absolute z-10 font-semibold text-accent text-[3cqw] leading-none select-none', x, y]}
          data-spark
          aria-hidden="true"
        >
          +
        </span>
      ))
    }
    </div>
  </div>
</div>

<style>
  .scene-stage {
    container-type: inline-size;
    perspective: 1500px;
    perspective-origin: 50% 45%;
  }
  .scene-camera,
  .scene {
    transform-style: preserve-3d;
  }
  /* Elk los stuk leeft in dezelfde 3D-ruimte en werpt een zachte schaduw. */
  .piece {
    transform-style: preserve-3d;
    box-shadow: 0 1.4cqw 3.5cqw -0.8cqw rgb(0 0 0 / 0.55);
  }
  .scene-frame {
    box-shadow:
      0 0 0 0.15cqw rgb(250 248 244 / 0.16),
      0 3cqw 7cqw -1.5cqw rgb(0 0 0 / 0.7);
  }
  /* Zachte "vloer": een gloed onder de scène, puur radiale gradient (geen
     filter:blur — die is op mobiel duur).
     De diepte staat bewust NIET hier maar in scene-timeline.ts: GSAP
     schrijft de hele transform en zou een CSS-translateZ overschrijven. */
  .scene-floor {
    background: radial-gradient(
      ellipse 70% 60% at 50% 55%,
      color-mix(in oklab, var(--accent) 42%, transparent),
      transparent 70%
    );
  }
  .scene-glow {
    box-shadow:
      inset 0 0 0 0.25cqw color-mix(in oklab, var(--accent) 85%, transparent),
      0 0 7cqw 0.5cqw color-mix(in oklab, var(--accent) 50%, transparent);
  }
  /* Zonder JS: geen schets, geen sterretjes — gewoon het eindresultaat.
     (Mét JS zet global.css de "exploded" begintoestand vóór de eerste paint.) */
  [data-sketch],
  [data-spark] {
    opacity: 0;
  }
  .mini-cta {
    cursor: pointer;
  }
</style>
