---
/**
 * Leadformulier in de configurator.
 * Verstuurt naar POST /api/lead; faalt dat (geen Resend-key, netwerk,
 * server), dan verschijnt automatisch de mailto:-fallback. De
 * WhatsApp-knop staat er altijd naast als alternatief.
 */
import { site } from '../data/site';
import { content, toLocale, altPath } from '../data/content';
const locale = toLocale(Astro.currentLocale);
const { configurator } = content(locale);
const f = configurator.form;
---

<form
  class="mt-6 grid gap-3"
  data-lead-form
  data-msg-validation={f.errorValidation}
  data-msg-sending={f.sending}
  data-msg-selfcopy={f.selfCopyError}
  novalidate
>
  <p class="font-display text-lg font-semibold">{f.title}</p>
  <p class="text-muted-dark -mt-1 text-sm leading-snug">{f.lead}</p>

  <div>
    <label class="text-sm font-medium" for="lead-name">{f.name} *</label>
    <input
      id="lead-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      class="lead-input mt-1 w-full"
    />
  </div>
  <div>
    <label class="text-sm font-medium" for="lead-company">{f.company}</label>
    <input
      id="lead-company"
      name="company"
      type="text"
      autocomplete="organization"
      class="lead-input mt-1 w-full"
    />
  </div>
  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <label class="text-sm font-medium" for="lead-phone">{f.phone}</label>
      <input
        id="lead-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        class="lead-input mt-1 w-full"
      />
    </div>
    <div>
      <label class="text-sm font-medium" for="lead-email">{f.email} *</label>
      <input
        id="lead-email"
        name="email"
        type="email"
        inputmode="email"
        required
        autocomplete="email"
        class="lead-input mt-1 w-full"
      />
    </div>
  </div>
  <div>
    <label class="text-sm font-medium" for="lead-message">{f.message}</label>
    <textarea id="lead-message" name="message" rows="3" class="lead-input mt-1 w-full"></textarea>
  </div>

  {/* Honeypot: visueel én voor hulptechnologie verborgen, maar bots vullen 'm in. */}
  <div class="hp-field" aria-hidden="true">
    <label for="lead-website">Website</label>
    <input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p id="lead-error" class="hidden text-sm font-medium text-red-300" data-lead-error role="alert"></p>

  <button
    type="submit"
    class="rounded-xl bg-accent px-5 py-3.5 font-semibold text-white transition-opacity hover:opacity-90 disabled:opacity-60"
    data-lead-submit
  >
    {f.submit}
  </button>

  {/* Lage drempel: wie nog niet wil aanvragen, kan zijn lijstje mailen. */}
  <button
    type="button"
    class="text-muted-dark text-sm underline underline-offset-4 hover:text-cream"
    data-lead-selfcopy
  >
    {f.selfCopy}
  </button>

  <a
    class="rounded-xl border border-white/25 px-5 py-3.5 text-center text-sm font-semibold transition-colors hover:border-accent"
    data-lead-whatsapp
    href={`https://wa.me/${site.whatsapp}`}
    target="_blank"
    rel="noopener"
  >
    💬 {f.whatsappButton}
  </a>

  {/* Fallback-paneel: verschijnt alleen als de API niet thuis geeft. */}
  <div class="hidden rounded-xl border border-amber-300/40 bg-amber-300/10 p-4 text-sm" data-lead-fallback>
    <p>{f.errorSend}</p>
    <a
      class="mt-3 inline-block rounded-xl bg-cream px-4 py-2.5 font-semibold text-ink"
      data-lead-mailto
      href={`mailto:${site.email}`}
    >
      ✉️ {f.mailtoButton}
    </a>
  </div>

  <p class="text-muted-dark text-xs">
    {f.privacyNote}
    <a href={altPath('/privacy', locale)} class="underline underline-offset-2 hover:text-cream">{f.privacyLink}</a>.
  </p>
</form>

{/* Succes-paneel vervangt het formulier na verzending */}
<div class="mt-6 hidden rounded-xl border border-green-300/40 bg-green-300/10 p-5" data-lead-success role="status" tabindex="-1">
  <p class="text-2xl" aria-hidden="true">🎉</p>
  <p class="mt-2 font-medium">{f.success}</p>

  {/* Het moment ná verzenden is de piek van de intentie; die werd tot nu toe
      helemaal niet gebruikt. Optie 1 op de menukaart is een online agenda —
      dan is een belmoment kiezen wel het minste wat hier hoort te staan. */}
  <div class="mt-5 border-t border-green-300/30 pt-4" data-lead-call>
    <p class="font-medium">{f.callTitle}</p>
    <p class="text-muted-dark mt-1 text-sm">{f.callLead}</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {
        f.callOptions.map((optie) => (
          <button
            type="button"
            class="inline-flex min-h-11 items-center rounded-xl border border-white/25 px-4 text-sm font-medium transition-colors hover:border-accent"
            data-call-slot={optie}
          >
            {optie}
          </button>
        ))
      }
      <a
        href={`tel:+${site.whatsapp}`}
        class="text-muted-dark inline-flex min-h-11 items-center px-2 text-sm underline underline-offset-4 hover:text-cream"
      >
        {f.callSelf}: {site.whatsappDisplay}
      </a>
    </div>
    <p class="mt-3 hidden text-sm font-medium text-green-200" data-call-done>{f.callDone}</p>
  </div>
</div>

<style>
  .lead-input {
    border-radius: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.06);
    padding: 0.65rem 1rem;
    /* 16px: onder die grens zoomt iOS Safari bij focus automatisch in. */
    font-size: 1rem;
    color: var(--color-cream);
    transition: border-color 0.15s ease;
  }
  @media (min-width: 640px) {
    .lead-input {
      font-size: 0.9rem;
    }
  }
  .lead-input:focus {
    border-color: var(--accent);
  }
  .lead-input[data-invalid] {
    border-color: rgb(252 165 165);
  }
  /* Honeypot: van het scherm af, niet display:none (simpele bots checken dat) */
  .hp-field {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  import { site } from '../data/site';
  import { validateLead } from '../lib/lead';
  import { summarizeSelection } from '../lib/quote';
  import { getSelection, subscribe } from '../scripts/store';
  import { content } from '../data/content';

  /* Zonder argument leest content() de taal van <html lang>. */
  const { quote: q } = content();

  const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
  if (form) {
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-lead-submit]')!;
    const errorEl = form.querySelector<HTMLElement>('[data-lead-error]')!;
    const fallback = form.querySelector<HTMLElement>('[data-lead-fallback]')!;
    const mailtoLink = form.querySelector<HTMLAnchorElement>('[data-lead-mailto]')!;
    const whatsappLink = form.querySelector<HTMLAnchorElement>('[data-lead-whatsapp]')!;
    const successEl = document.querySelector<HTMLElement>('[data-lead-success]')!;
    const submitLabel = submitBtn.textContent;

    const fieldValue = (name: string) =>
      (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? '';

    // WhatsApp-deeplink altijd actueel houden met de huidige samenstelling.
    subscribe((sel) => {
      const text = `${q.greeting}${summarizeSelection(sel)}`;
      whatsappLink.href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(text)}`;
    });

    const markInvalid = (names: string[]) => {
      for (const el of form.querySelectorAll('.lead-input')) {
        el.removeAttribute('data-invalid');
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
      }
      for (const name of names) {
        const el = form.elements.namedItem(name) as HTMLElement | null;
        el?.setAttribute('data-invalid', '');
        el?.setAttribute('aria-invalid', 'true');
        el?.setAttribute('aria-describedby', 'lead-error');
      }
    };

    function showFallback(): void {
      const summary = [
        summarizeSelection(getSelection()),
        '',
        `${q.name}: ${fieldValue('name')}`,
        `${q.company}: ${fieldValue('company')}`,
        `${q.phone}: ${fieldValue('phone')}`,
        fieldValue('message') ? `${q.note}: ${fieldValue('message')}` : '',
      ]
        .join('\n')
        .slice(0, 1400); // mailto-body's hebben een praktische lengtegrens

      mailtoLink.href = `mailto:${site.email}?subject=${encodeURIComponent(
        q.subject,
      )}&body=${encodeURIComponent(summary)}`;
      fallback.classList.remove('hidden');
    }

    /* Zelfde endpoint, andere intent: alleen het e-mailadres is verplicht. */
    form.querySelector<HTMLButtonElement>('[data-lead-selfcopy]')?.addEventListener('click', async () => {
      const email = fieldValue('email');
      if (!email) {
        markInvalid(['email']);
        errorEl.textContent = form.dataset.msgSelfcopy!;
        errorEl.classList.remove('hidden');
        (form.elements.namedItem('email') as HTMLElement | null)?.focus();
        return;
      }
      markInvalid([]);
      errorEl.classList.add('hidden');
      try {
        await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: fieldValue('name'),
            company: fieldValue('company'),
            phone: fieldValue('phone'),
            email,
            message: fieldValue('message'),
            website: fieldValue('website'),
            selection: getSelection(),
            locale: document.documentElement.lang === 'en' ? 'en' : 'nl',
            intent: 'selfcopy',
          }),
        });
        successEl.classList.remove('hidden');
        successEl.focus();
        form.classList.add('hidden');
      } catch {
        showFallback();
      }
    });

    /* Belkeuze: dezelfde route, met de gekozen tijd als opmerking erbij. */
    successEl.querySelectorAll<HTMLButtonElement>('[data-call-slot]').forEach((knop) =>
      knop.addEventListener('click', async () => {
        const gekozen = knop.dataset.callSlot!;
        successEl.querySelectorAll<HTMLButtonElement>('[data-call-slot]').forEach((k) => {
          k.disabled = true;
          k.classList.toggle('border-accent', k === knop);
        });
        successEl.querySelector('[data-call-done]')?.classList.remove('hidden');
        try {
          await fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: fieldValue('name'),
              company: fieldValue('company'),
              phone: fieldValue('phone'),
              email: fieldValue('email'),
              message: `${fieldValue('message')}\n\n[belvoorkeur] ${gekozen}`.trim(),
              website: fieldValue('website'),
              selection: getSelection(),
              locale: document.documentElement.lang === 'en' ? 'en' : 'nl',
              intent: 'call',
            }),
          });
        } catch {
          /* Mislukt hij, dan heeft Scott de aanvraag zelf al binnen. */
        }
      }),
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl.classList.add('hidden');

      const payload = {
        name: fieldValue('name'),
        company: fieldValue('company'),
        phone: fieldValue('phone'),
        email: fieldValue('email'),
        message: fieldValue('message'),
        website: fieldValue('website'),
        selection: getSelection(),
        locale: document.documentElement.lang === 'en' ? 'en' : 'nl',
        intent: 'quote' as const,
      };

      // Zelfde validatie als de server → directe feedback zonder roundtrip.
      const check = validateLead(payload);
      if (!check.ok) {
        markInvalid(check.fields);
        errorEl.textContent = form.dataset.msgValidation ?? '';
        errorEl.classList.remove('hidden');
        return;
      }
      markInvalid([]);

      submitBtn.disabled = true;
      submitBtn.textContent = form.dataset.msgSending ?? '…';

      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 10_000);
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        clearTimeout(timeout);

        if (res.ok) {
          form.classList.add('hidden');
          successEl.classList.remove('hidden');
          return;
        }
        if (res.status === 400) {
          const body = await res.json().catch(() => null);
          markInvalid(Array.isArray(body?.fields) ? body.fields : []);
          errorEl.textContent = form.dataset.msgValidation ?? '';
          errorEl.classList.remove('hidden');
          return;
        }
        // 502/503/5xx → nette fallback
        showFallback();
      } catch {
        // Netwerkfout of timeout
        showFallback();
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      }
    });
  }
</script>
