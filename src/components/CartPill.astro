---
/**
 * Zwevende "winkelmand"-pill: verschijnt zodra de bezoeker op de
 * menukaart iets toevoegt en toont het lopende subtotaal van de
 * gekozen extra's. Klik = naar de configurator.
 */
import { content } from '../data/content';
const { configurator } = content(Astro.currentLocale);
---

<a
  href="#configurator"
  class="cart-pill fixed bottom-4 left-1/2 z-40 flex max-w-[calc(100vw-2rem)] -translate-x-1/2 translate-y-20 items-center gap-2.5 rounded-full bg-ink px-5 py-3 text-xs font-semibold whitespace-nowrap text-cream opacity-0 shadow-card-lg ring-1 ring-white/15 transition-all duration-300 hover:ring-accent sm:text-sm motion-reduce:transition-none"
  data-cart-pill
  data-cart-one={configurator.cartOne}
  data-cart-many={configurator.cartMany}
  data-cart-total-label={configurator.cartTotal}
  aria-hidden="true"
  tabindex="-1"
>
  <span
    class="flex h-6 w-6 items-center justify-center rounded-full bg-accent text-xs text-white"
    data-cart-count>0</span
  >
  <span data-cart-label>{configurator.cartMany}</span>
  <span class="text-muted-dark">·</span>
  <span data-cart-total></span>
  <span aria-hidden="true">→</span>
</a>

<script>
  import { addons } from '../data/pricing';
  import { calcTotals, isIncluded } from '../lib/calc';
  import { eur, perMaand } from '../lib/format';
  import { subscribe } from '../scripts/store';

  const pill = document.querySelector<HTMLAnchorElement>('[data-cart-pill]')!;
  const count = pill.querySelector<HTMLElement>('[data-cart-count]')!;
  const label = pill.querySelector<HTMLElement>('[data-cart-label]')!;
  const total = pill.querySelector<HTMLElement>('[data-cart-total]')!;

  subscribe((sel) => {
    // Inbegrepen add-ons horen bij het pakket en tellen hier niet mee.
    const chosen = addons.filter(
      (a) => sel.addons.includes(a.id) && !isIncluded(sel.base, a.id),
    );
    /* Het hele voorstel, niet alleen de extra's: de pill toonde eerder
       € 490 terwijl de offerte ernaast € 1.285 zei. */
    const totals = calcTotals(sel);

    count.textContent = String(chosen.length);
    label.textContent = chosen.length === 1 ? pill.dataset.cartOne! : pill.dataset.cartMany!;
    total.textContent =
      totals.monthly > 0
        ? `${eur(totals.upfront)} + ${eur(totals.monthly)}${perMaand()}`
        : eur(totals.upfront);

    const visible = chosen.length > 0;
    pill.classList.toggle('translate-y-20', !visible);
    pill.classList.toggle('opacity-0', !visible);
    pill.setAttribute('aria-hidden', String(!visible));
    pill.tabIndex = visible ? 0 : -1;
  });

  /* In de configurator staat het totaal al groot in beeld; de pill zou daar
     alleen maar over de knoppen heen liggen. */
  const cfg = document.querySelector('#configurator');
  if (cfg) {
    new IntersectionObserver(([e]) => pill.classList.toggle('cart-pill-off', e.isIntersecting), {
      threshold: 0,
    }).observe(cfg);
  }
</script>
