---
/** "Zo werkt het" — drie stappen met een staggered reveal (zie motion.ts). */
import { howItWorks } from '../data/site';
---

<section class="bg-cream py-16 text-ink sm:py-24" id="zo-werkt-het" data-reveal-section>
  <div class="mx-auto max-w-6xl px-5">
    <header class="max-w-2xl" data-reveal>
      <p class="kicker">{howItWorks.kicker}</p>
      <h2 class="font-display text-h2 mt-2 font-semibold">{howItWorks.title}</h2>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        howItWorks.steps.map((step, i) => (
          <article
            class="rounded-2xl border border-line bg-white p-7 shadow-card"
            data-step-card
          >
            <span class="font-display flex h-10 w-10 items-center justify-center rounded-full bg-accent text-lg font-semibold text-white">
              {i + 1}
            </span>
            <h3 class="font-display mt-5 text-xl font-semibold">{step.title}</h3>
            <p class="text-muted mt-2 leading-relaxed">{step.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
