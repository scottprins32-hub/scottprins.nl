---
/**
 * Taalschakelaar NL | EN. Een echte link naar dezelfde pagina in de andere
 * taal: werkt zonder JavaScript, is deelbaar en Google ziet beide versies.
 */
import { content, toLocale, altPath, LOCALES } from '../data/content';
import { url, stripBase } from '../lib/url';

interface Props {
  class?: string;
  /** 'paper' op lichte achtergrond. */
  tone?: 'ink' | 'paper';
}
const { class: className = '', tone = 'ink' } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const { nav } = content(locale);
/* Het pad zonder base en zonder taalprefix: zo blijf je op /privacy als je wisselt. */
const kaal = stripBase(Astro.url.pathname).replace(/^\/en(?=\/|$)/, '') || '/';
---

<div class:list={['lang', `lang-${tone}`, className]} role="group" aria-label={nav.langLabel}>
  {
    LOCALES.map((code) => {
      const actief = code === locale;
      return (
        <a
          href={url(altPath(kaal, code))}
          hreflang={code}
          lang={code}
          aria-current={actief ? 'true' : undefined}
          class:list={['lang-link', { 'is-active': actief }]}
        >
          <span aria-hidden="true">{code}</span>
          <span class="sr-only">{actief ? (code === 'nl' ? 'Nederlands' : 'English') : nav.langSwitchTo}</span>
        </a>
      );
    })
  }
</div>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .lang-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: 999px;
    color: var(--color-mute);
    transition: color 0.2s;
  }
  .lang-link:hover {
    color: var(--color-bone);
  }
  .lang-link.is-active {
    color: var(--color-bone);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }
  .lang-paper .lang-link {
    color: var(--color-paper-mute);
  }
  .lang-paper .lang-link:hover,
  .lang-paper .lang-link.is-active {
    color: var(--color-paper-ink);
  }
</style>
