---
/**
 * Landingspagina per branche (nu: fysiotherapie). Eigen tekst, het
 * upgrade-ding met de juiste branche al gekozen, de prijs en de bestelbon.
 */
import type { Branche } from '../data/content/branches';
import { offer } from '../data/offer';
import SiteNav from './SiteNav.astro';
import SiteFooter from './SiteFooter.astro';
import Upgrade from './upgrade/Upgrade.astro';
import Order from './Order.astro';
import StickyCta from './StickyCta.astro';
import Icon from './Icon.astro';
import Rise from './Rise.astro';

interface Props {
  branche: Branche;
}
const { branche: b } = Astro.props;
const digits = String(offer.price);
---

<SiteNav home={false} />
<main id="main" tabindex="-1">
  <section class="hero bp-hero" aria-labelledby="bp-title">
    <div class="wrap bp-grid">
      <p class="label bp-eyebrow intro-up" style="--d:0s">{b.eyebrow}</p>
      <h1 id="bp-title" class="display bp-title"><Rise text={b.h1} /></h1>
      <p class="lead bp-intro intro-up" style="--d:0.45s">{b.intro}</p>
      <div class="bp-ctas intro-up" style="--d:0.55s" data-sticky-after>
        <a class="btn btn-signal" href="#bestellen" data-magnetic>{b.ctaButton}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <section class="bp-demo" aria-labelledby="bp-demo-title">
    <div class="wrap">
      <h2 id="bp-demo-title" class="bp-h2" data-reveal="title">{b.demoTitle}</h2>
      <p class="lead bp-demo-lead" data-reveal="up">{b.demoLead}</p>
      <div class="bp-device">
        <Upgrade id="upgrade" trade={b.trade} />
      </div>
    </div>
  </section>

  <section class="section-pad bp-pain" aria-labelledby="bp-pain-title">
    <div class="wrap bp-two">
      <h2 id="bp-pain-title" class="display bp-h2-big" data-reveal="title">{b.painTitle}</h2>
      <ul class="bp-list">
        {
          b.pain.map((item) => (
            <li data-reveal="up">
              <Icon name="x" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-pad bp-body" aria-labelledby="bp-body-title">
    <div class="wrap bp-two">
      <h2 id="bp-body-title" class="display bp-h2-big" data-reveal="title">{b.bodyTitle}</h2>
      <div class="bp-text">
        {
          b.body.map((paragraph) => (
            <p class="lead" data-reveal="up">
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bp-price" aria-labelledby="bp-price-title">
    <div class="wrap bp-two">
      <div>
        <h2 id="bp-price-title" class="bp-price-q">{b.priceTitle}</h2>
        <p class="bp-amount" aria-hidden="true"><span>€</span>{digits}</p>
      </div>
      <div class="bp-price-copy">
        <p class="lead">{b.priceLead}</p>
        <h3 class="bp-cta-title">{b.ctaTitle}</h3>
        <p>{b.ctaLead}</p>
        <a class="btn btn-ink" href="#bestellen" data-magnetic>{b.ctaButton}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <Order trade={b.trade} />
  <StickyCta />
</main>
<SiteFooter home={false} />

<script>
  import { initPage } from '../scripts/page';
  initPage();
</script>

<style>
  .bp-hero {
    padding-top: calc(4.5rem + clamp(2.5rem, 8vh, 6rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .bp-grid {
    display: grid;
    gap: 1.5rem;
  }
  .bp-eyebrow {
    margin: 0;
    color: var(--color-signal-text);
  }
  .bp-title {
    max-width: 18ch;
    margin: 0;
    font-size: var(--text-display-l);
  }
  .bp-intro {
    max-width: 40rem;
    margin: 0.5rem 0 0;
    color: var(--color-bone-2);
  }
  .bp-ctas {
    margin-top: 1rem;
  }
  .bp-demo {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .bp-h2 {
    margin: 0;
    font-size: var(--text-display-m);
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .bp-demo-lead {
    max-width: 36rem;
    margin: 1rem 0 2.5rem;
    color: var(--color-bone-2);
  }
  .bp-device {
    width: min(100%, calc((100svh - 13.5rem) * 1.6));
    margin-inline: auto;
  }
  .bp-pain,
  .bp-body {
    border-top: 1px solid var(--color-line);
  }
  .bp-two {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .bp-h2-big {
    margin: 0;
    font-size: var(--text-display-l);
  }
  .bp-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  .bp-list li {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    font-weight: 560;
    letter-spacing: -0.01em;
  }
  .bp-list :global(.icon) {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.15em;
    color: var(--color-signal-text);
  }
  .bp-text {
    display: grid;
    gap: 1.25rem;
  }
  .bp-text .lead {
    margin: 0;
    color: var(--color-bone-2);
  }
  .bp-price {
    padding-block: clamp(5rem, 10vw, 8rem);
    background: var(--color-paper);
    color: var(--color-paper-ink);
    color-scheme: light;
  }
  .bp-price :global(:focus-visible) {
    outline-color: var(--color-paper-ink);
  }
  .bp-price-q {
    margin: 0;
    font-size: var(--text-display-m);
    font-weight: 640;
    font-stretch: 110%;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .bp-amount {
    display: flex;
    align-items: flex-start;
    margin: 1rem 0 0;
    font-size: clamp(6rem, 16vw, 13rem);
    font-weight: 800;
    font-stretch: 118%;
    letter-spacing: -0.055em;
    line-height: 0.85;
  }
  .bp-amount span {
    margin-right: 0.04em;
    font-size: 0.42em;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0;
  }
  .bp-price-copy {
    display: grid;
    justify-items: start;
    gap: 1rem;
    align-content: end;
  }
  .bp-price-copy p {
    max-width: 34rem;
    margin: 0;
  }
  .bp-cta-title {
    margin: 1.5rem 0 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 700;
    font-stretch: 110%;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  @media (min-width: 64rem) {
    .bp-two {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }
</style>
