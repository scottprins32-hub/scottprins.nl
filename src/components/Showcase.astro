---
/**
 * Voorbeelden: twee complete demo-sites, elk met een nagebouwde mini-preview.
 *
 * Waarom nagebouwd en niet ingesloten of gefotografeerd: base44 stuurt
 * `x-frame-options: DENY` mee (dus een iframe wordt geweigerd), en een
 * screenshot veroudert zodra de demo verandert. Zo blijft het klikbaar,
 * zelf-gehost en altijd actueel — en staat de echte site één knop verderop.
 */
import { showcase } from '../data/site';
import { addons } from '../data/pricing';
import PreviewFysio from './showcase/PreviewFysio.astro';
import PreviewVakman from './showcase/PreviewVakman.astro';

const addonName = new Map(addons.map((a) => [a.id, a.name]));
---

<section class="bg-cream py-16 text-ink sm:py-24" id="voorbeelden" data-reveal-section>
  <div class="mx-auto max-w-6xl px-5">
    <header class="max-w-2xl" data-reveal>
      <p class="kicker">{showcase.kicker}</p>
      <h2 class="font-display text-h2 mt-2 font-semibold">{showcase.title}</h2>
      <p class="text-muted text-lead mt-3">{showcase.lead}</p>
    </header>

    <div class="mt-10 grid items-start gap-6 md:grid-cols-2">
      {
        showcase.sites.map((s, i) => (
          <article
            class="flex flex-col rounded-2xl border border-line bg-white p-6 shadow-card transition-shadow hover:shadow-card-lg sm:p-7"
            data-reveal
          >
            <p class="kicker">{s.sector}</p>
            <h3 class="font-display text-h3 mt-2 font-semibold">{s.name}</h3>
            <p class="text-muted mt-2 text-sm">{s.tryThis}</p>

            <div class="mt-5">{i === 0 ? <PreviewFysio /> : <PreviewVakman />}</div>

            <p class="text-muted mt-4 text-xs leading-relaxed">{s.rest}</p>

            {/* Terug naar de menukaart: elke voorbeeldsite is opgebouwd uit
                opties die hierboven los te proberen — en te bestellen — zijn. */}
            <p class="mt-4 flex flex-wrap gap-2">
              {s.addons.map((id) => (
                <a
                  href={`#menu-${id}`}
                  class="rounded-full bg-cream-dim px-3 py-1 text-xs font-medium text-muted transition-colors hover:text-accent"
                >
                  {addonName.get(id)}
                </a>
              ))}
            </p>

            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="mt-5 inline-flex w-fit items-center gap-2 rounded-xl bg-ink px-5 py-3 text-sm font-semibold text-cream transition-colors hover:bg-accent"
            >
              Open de hele site
              <span aria-hidden="true">↗</span>
              <span class="sr-only">— {s.name}, opent in een nieuw tabblad</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
