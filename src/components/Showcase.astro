---
/**
 * Voorbeelden: twee complete demo-sites, elk met zijn samenstelling én de
 * prijs van het geheel.
 *
 * Dit is de enige plek op de pagina waar staat wat een héle site kost — de
 * menukaart geeft losse opties, de configurator laat je zelf rekenen. Daarmee
 * is deze sectie de brug: losse onderdelen → twee complete recepten → jouw
 * eigen samenstelling.
 *
 * Waarom de demo niet ingesloten is: base44 stuurt `x-frame-options: DENY`
 * mee, dus een iframe wordt geweigerd. Vandaar een schermafbeelding die zelf
 * de link is.
 *
 * Alle bedragen komen uit pricing.ts via calcTotals — nooit ingetypt, zodat
 * een prijswijziging hier vanzelf meeloopt.
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { showcase } from '../data/site';
import { addons } from '../data/pricing';
import { calcTotals, addonCost, isIncluded } from '../lib/calc';
import { eur, eurPerMonth, priceLine } from '../lib/format';

const addonById = new Map(addons.map((a) => [a.id, a]));

/* Vanaf de projectmap, niet vanaf dit bestand: na compilatie wijst
   `import.meta.url` niet meer naar src/components/ en zou de check
   stilletjes altijd 'nee' zeggen. */
const hasImage = (base: string): boolean =>
  existsSync(resolve(process.cwd(), `public${base}-1200.webp`));

/** Regels + totaal per kaart, één keer uitgerekend bij het bouwen. */
const kaarten = showcase.sites.map((s) => {
  const regels = s.addons.map((id) => {
    const addon = addonById.get(id)!;
    const kosten = addonCost(s.base, addon);
    const gratis = isIncluded(s.base, id);
    return {
      naam: addon.name,
      doet: (s.does as Record<string, string>)[id],
      /* 'Inbegrepen' is hier het sterkste woord op de kaart: het laat zien
         dat een groter pakket opties meebrengt in plaats van bijtelt. */
      prijs: gratis ? 'included' : priceLine(kosten.upfront, kosten.monthly),
      gratis,
      /* Niet `#menu-${id}` aannemen: bij 'cadeaubonnen' heet de sectie
         'menu-cadeau', en sms/nieuwsbrief/ai-telefonist hebben er geen. */
      href: addon.demoSectionId ? `#${addon.demoSectionId}` : null,
    };
  });
  return { ...s, regels, totaal: calcTotals({ base: s.base, addons: [...s.addons], care: 'basis' }) };
});
---

<section class="bg-cream py-16 text-ink sm:py-24" id="examples" data-reveal-section>
  <div class="mx-auto max-w-6xl px-5">
    <header class="max-w-2xl" data-reveal>
      <p class="kicker">{showcase.kicker}</p>
      <h2 class="font-display text-h2 mt-2 font-semibold">{showcase.title}</h2>
      <p class="text-muted text-lead mt-3">{showcase.lead}</p>
    </header>

    {/* Geen items-start: zo worden beide kaarten even hoog en staan de twee
        knoppen op één lijn. */}
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        kaarten.map((s) => (
          <article
            class="flex flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-card transition-shadow hover:shadow-card-lg"
            data-reveal
          >
            {
              hasImage(s.image) && (
                /* Het beeld is zelf de link. aria-hidden en niet focusbaar:
                   de knop onderaan gaat naar dezelfde plek, dus anders kom je
                   met toetsenbord twee keer langs hetzelfde. */
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="group/shot relative block border-b border-line bg-cream-dim"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <span class="flex items-center gap-1.5 bg-white px-3 py-2">
                    <span class="size-2 rounded-full bg-line" />
                    <span class="size-2 rounded-full bg-line" />
                    <span class="size-2 rounded-full bg-line" />
                    <span class="text-muted ml-2 truncate text-xs">{s.domain}</span>
                  </span>
                  <span class="block overflow-hidden">
                    <img
                      src={`${s.image}-1200.webp`}
                      srcset={`${s.image}-600.webp 600w, ${s.image}-1200.webp 1200w`}
                      sizes="(min-width: 768px) 45vw, 90vw"
                      width="1200"
                      height="687"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="w-full transition-transform duration-500 group-hover/shot:scale-[1.03]"
                    />
                  </span>
                  {/* Altijd zichtbaar, niet alleen bij hover: op een telefoon
                      bestaat hover niet en moet het beeld tóch als deur lezen. */}
                  <span class="absolute right-3 bottom-3 rounded-lg bg-white/95 px-2.5 py-1 text-xs font-semibold shadow-card">
                    {showcase.liveBadge} ↗
                  </span>
                </a>
              )
            }

            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class="kicker">{s.sector}</p>
              <h3 class="font-display text-h3 mt-2 font-semibold">{s.name}</h3>
              <p class="text-muted mt-2 text-sm leading-relaxed">{s.summary}</p>

              <p class="text-muted mt-6 text-xs font-semibold tracking-wide uppercase">
                {showcase.contentsLabel}
              </p>
              <ul class="mt-2 divide-y divide-line border-y border-line">
                {s.regels.map((r) => (
                  <li class="flex items-baseline justify-between gap-4 py-2.5">
                    <span class="min-w-0 text-sm">
                      {r.href ? (
                        <a
                          href={r.href}
                          class="font-medium underline decoration-line underline-offset-4 hover:text-accent"
                        >
                          {r.naam}
                        </a>
                      ) : (
                        <span class="font-medium">{r.naam}</span>
                      )}
                      <span class="text-muted"> — {r.doet}</span>
                    </span>
                    <span
                      class:list={[
                        'shrink-0 text-xs tabular-nums',
                        r.gratis ? 'font-semibold text-accent' : 'text-muted',
                      ]}
                    >
                      {r.prijs}
                    </span>
                  </li>
                ))}
              </ul>
              <p class="text-muted mt-2 text-xs">{s.extra}</p>

              {/* mt-auto duwt prijs en knoppen naar de onderrand, zodat ze bij
                  beide kaarten op dezelfde hoogte staan. */}
              <div class="mt-auto pt-6">
                <p class="flex items-baseline justify-between gap-3">
                  <span class="text-muted text-sm">{showcase.totalLabel}</span>
                  <span class="font-display text-lg font-semibold tabular-nums">
                    {priceLine(s.totaal.upfront, s.totaal.monthly)}
                  </span>
                </p>
                <p class="text-muted mt-1 text-xs">{showcase.totalNote}</p>

                <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 rounded-xl bg-ink px-5 py-3 text-sm font-semibold text-cream transition-colors hover:bg-accent"
                  >
                    {showcase.openCta}
                    <span aria-hidden="true">↗</span>
                    <span class="sr-only">— {s.name}, opens in a new tab</span>
                  </a>
                  {/* Bewust een tekstknop en geen tweede vlak: hij mag de
                      zwarte knop niet beconcurreren. */}
                  <button
                    type="button"
                    class="text-sm font-medium underline underline-offset-4 transition-colors hover:text-accent"
                    data-showcase-base={s.base}
                    data-showcase-addons={s.addons.join(',')}
                  >
                    {showcase.presetCta} →
                  </button>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { applyPreset } from '../scripts/store';
  import type { AddonId, BasePackageId } from '../data/pricing';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-showcase-base]')) {
    button.addEventListener('click', () => {
      applyPreset(
        button.dataset.showcaseBase as BasePackageId,
        button.dataset.showcaseAddons!.split(',') as AddonId[],
      );
      /* Niet zelf naar #configurator springen: de secties erboven staan op
         content-visibility en hebben pas een echte hoogte zodra ze renderen.
         Base.astro vangt dat af bij een klik op een <a href="#…">, dus laten
         we die het werk doen dat hij al goed doet. */
      document.querySelector<HTMLAnchorElement>('a[href="#configurator"]')?.click();
    });
  }
</script>
