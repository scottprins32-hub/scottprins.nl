---
/**
 * Voorbeelden: twee complete demo-sites.
 *
 * Waarom niet ingesloten: base44 stuurt `x-frame-options: DENY` mee, dus een
 * iframe wordt geweigerd. Vandaar een schermafbeelding die zelf de link is,
 * plus een nagebouwd stukje van de demo dat wél werkt.
 *
 * TIJDELIJK: `VARIANT` staat hier om drie opzetten naast elkaar te kunnen
 * bekijken. Zodra de keuze gemaakt is gaat deze schakelaar eruit en blijft
 * er één opbouw over.
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { showcase } from '../data/site';
import { addons } from '../data/pricing';
import PreviewFysio from './showcase/PreviewFysio.astro';
import PreviewVakman from './showcase/PreviewVakman.astro';

type Variant = 'huidig' | 'zonder' | 'uitklap';
const VARIANT: Variant = 'uitklap';

const addonById = new Map(addons.map((a) => [a.id, a]));

/* Niet `#menu-${id}` aannemen: bij 'cadeaubonnen' heet de sectie
   'menu-cadeau', en drie opties (sms, nieuwsbrief, ai-telefonist) hebben
   helemaal geen demo-sectie. pricing.ts weet het, dus vraag het daar. */

/* Vanaf de projectmap, niet vanaf dit bestand: na compilatie wijst
   `import.meta.url` niet meer naar src/components/ en zou de check
   stilletjes altijd 'nee' zeggen. */
const hasImage = (base: string): boolean =>
  existsSync(resolve(process.cwd(), `public${base}-1200.webp`));
---

<section class="bg-cream py-16 text-ink sm:py-24" id="voorbeelden" data-reveal-section>
  <div class="mx-auto max-w-6xl px-5">
    <header class="max-w-2xl" data-reveal>
      <p class="kicker">{showcase.kicker}</p>
      <h2 class="font-display text-h2 mt-2 font-semibold">{showcase.title}</h2>
      <p class="text-muted text-lead mt-3">{showcase.lead}</p>
    </header>

    <div class="mt-10 grid items-start gap-6 md:grid-cols-2">
      {
        showcase.sites.map((s, i) => (
          <article
            class="flex flex-col rounded-2xl border border-line bg-white p-6 shadow-card transition-shadow hover:shadow-card-lg sm:p-7"
            data-reveal
          >
            {
              hasImage(s.image) && (
                /* Het beeld is zelf de link naar de demo. aria-hidden en niet
                   focusbaar: de knop eronder gaat naar dezelfde plek, dus
                   anders kom je met toetsenbord twee keer langs hetzelfde. */
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="group/shot mb-5 block overflow-hidden rounded-xl border border-line bg-cream-dim"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <span class="flex items-center gap-1.5 border-b border-line bg-white px-3 py-2">
                    <span class="size-2 rounded-full bg-line" />
                    <span class="size-2 rounded-full bg-line" />
                    <span class="size-2 rounded-full bg-line" />
                  </span>
                  <img
                    src={`${s.image}-1200.webp`}
                    srcset={`${s.image}-600.webp 600w, ${s.image}-1200.webp 1200w`}
                    sizes="(min-width: 768px) 45vw, 90vw"
                    width="1200"
                    height="687"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="w-full transition-transform duration-500 group-hover/shot:scale-[1.03]"
                  />
                </a>
              )
            }

            <p class="kicker">{s.sector}</p>
            <h3 class="font-display text-h3 mt-2 font-semibold">{s.name}</h3>

            {VARIANT !== 'zonder' && <p class="text-muted mt-2 text-sm">{s.tryThis}</p>}

            {/* A — huidig: het widget staat er meteen, altijd open. */}
            {VARIANT === 'huidig' && <div class="mt-5">{i === 0 ? <PreviewFysio /> : <PreviewVakman />}</div>}

            {/* C — uitklap: rust op de kaart, interactie op verzoek.
                <details> doet dit zonder een regel JavaScript en is
                out of the box bedienbaar met het toetsenbord. */}
            {
              VARIANT === 'uitklap' && (
                <details class="pv-details mt-4 rounded-xl border border-line">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-medium transition-colors hover:text-accent">
                    {s.tryHere}
                    <span class="pv-chev text-muted transition-transform" aria-hidden="true">
                      ▾
                    </span>
                  </summary>
                  <div class="border-t border-line p-4">{i === 0 ? <PreviewFysio /> : <PreviewVakman />}</div>
                </details>
              )
            }

            <p class="text-muted mt-4 text-xs leading-relaxed">{s.rest}</p>

            {/* Terug naar de menukaart: elke voorbeeldsite is opgebouwd uit
                opties die hierboven los te proberen — en te bestellen — zijn. */}
            <p class="mt-4 flex flex-wrap gap-2">
              {s.addons.map((id) => {
                const addon = addonById.get(id)!;
                const chip = 'rounded-full bg-cream-dim px-3 py-1 text-xs font-medium text-muted';
                return addon.demoSectionId ? (
                  <a href={`#${addon.demoSectionId}`} class={`${chip} transition-colors hover:text-accent`}>
                    {addon.name}
                  </a>
                ) : (
                  <span class={chip}>{addon.name}</span>
                );
              })}
            </p>

            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="mt-5 inline-flex w-fit items-center gap-2 rounded-xl bg-ink px-5 py-3 text-sm font-semibold text-cream transition-colors hover:bg-accent"
            >
              Open de hele site
              <span aria-hidden="true">↗</span>
              <span class="sr-only">— {s.name}, opent in een nieuw tabblad</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Safari toont anders nog een eigen driehoekje naast het onze. */
  .pv-details summary::-webkit-details-marker {
    display: none;
  }
  .pv-details[open] .pv-chev {
    transform: rotate(180deg);
  }
</style>
