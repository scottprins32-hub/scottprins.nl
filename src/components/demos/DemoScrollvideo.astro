---
/**
 * Demo 11 — Scroll-video / animaties. Wijst terug naar de intro: dit is
 * exact dezelfde scène (HeroScene + scene-timeline), maar nu op tijd
 * afgespeeld met een replay-knop. Zo ziet de bezoeker: dat effect van
 * net = optie 11.
 */
import { content } from '../../data/content';
const { demoScrollvideo } = content(Astro.currentLocale);
import HeroScene from '../HeroScene.astro';
---

<div class="grain relative overflow-hidden rounded-2xl bg-ink p-6 pb-16 shadow-card sm:p-8 sm:pb-18" data-scrollvideo>
  <HeroScene />
  <button
    type="button"
    class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-cream px-5 py-2.5 text-sm font-semibold text-ink shadow-card-lg transition-transform hover:scale-105 motion-reduce:hover:scale-100"
    data-scrollvideo-replay
  >
    ▶ {demoScrollvideo.replay}
  </button>
</div>

<script>
  import { gsap, prefersReducedMotion, ScrollTrigger } from '../../scripts/motion';
  import { buildSceneTimeline } from '../../scripts/scene-timeline';

  const root = document.querySelector<HTMLElement>('[data-scrollvideo]');
  if (root) {
    const sceneRoot = root.querySelector<HTMLElement>('[data-scene-root]')!;
    const replay = root.querySelector<HTMLButtonElement>('[data-scrollvideo-replay]')!;

    if (prefersReducedMotion()) {
      // Geen animatie gewenst: de scène staat al afgebouwd in de HTML.
      replay.classList.add('hidden');
    } else {
      // Zelfde timeline als de hero, maar op tijd (±6 s) i.p.v. scroll.
      const tl = buildSceneTimeline(sceneRoot).duration(6).timeScale(1);
      tl.eventCallback('onComplete', () => gsap.to(replay, { scale: 1, duration: 0.2 }));

      ScrollTrigger.create({
        trigger: root,
        start: 'top 70%',
        once: true,
        onEnter: () => tl.play(),
      });

      replay.addEventListener('click', () => tl.restart());
    }
  }
</script>
