---
/**
 * Demo 4 — Prijscalculator: drie sliders → live richtprijs.
 * De formule en alle bedragen staan in site.ts (demoCalculator.formula).
 */
import { content } from '../../data/content';
const { demoCalculator } = content(Astro.currentLocale);
---

<div class="rounded-2xl border border-line bg-white p-5 shadow-card sm:p-7" data-calc>
  <h3 class="font-display text-xl font-semibold">{demoCalculator.heading}</h3>

  <div class="mt-6 grid gap-6">
    {
      demoCalculator.sliders.map((slider) => (
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <label class="text-sm font-medium" for={`calc-${slider.id}`}>
              {slider.label}
            </label>
            <output class="text-sm font-semibold text-accent" data-calc-out={slider.id} for={`calc-${slider.id}`} />
          </div>
          <input
            type="range"
            id={`calc-${slider.id}`}
            class="calc-range mt-2 w-full"
            data-calc-slider={slider.id}
            min={slider.min}
            max={slider.max}
            value={slider.value}
            step="1"
            data-unit={slider.unit}
            data-labels={'labels' in slider ? JSON.stringify(slider.labels) : undefined}
          />
        </div>
      ))
    }
  </div>

  <div class="mt-7 rounded-xl bg-ink p-5 text-cream">
    <p class="text-muted-dark text-sm">{demoCalculator.resultLabel}</p>
    <p class="font-display mt-1 text-3xl font-semibold tabular-nums" data-calc-result data-value="0">€ 0</p>
    <p class="text-muted-dark mt-2 text-xs">{demoCalculator.disclaimer}</p>
  </div>
</div>

<script>
  import { content } from '../../data/content';
  const { demoCalculator } = content();
  import { eur } from '../../lib/format';
  import { tweenNumber } from '../../scripts/tween';

  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    const sliders = [...root.querySelectorAll<HTMLInputElement>('[data-calc-slider]')];
    const result = root.querySelector<HTMLElement>('[data-calc-result]')!;
    const { base, perM2, sanitair } = demoCalculator.formula;

    function value(id: string): number {
      return Number(sliders.find((s) => s.dataset.calcSlider === id)?.value ?? 0);
    }

    function update(): void {
      // Slider-uitlezing naast de labels ("6 m²" of "Comfort")
      for (const slider of sliders) {
        const out = root!.querySelector<HTMLElement>(`[data-calc-out="${slider.dataset.calcSlider}"]`)!;
        const labels = slider.dataset.labels ? (JSON.parse(slider.dataset.labels) as string[]) : null;
        out.textContent = labels
          ? labels[Number(slider.value) - 1]
          : `${slider.value} ${slider.dataset.unit ?? ''}`.trim();
      }

      const total =
        base +
        value('oppervlak') * perM2[value('afwerking') - 1] +
        sanitair[value('sanitair') - 1];
      tweenNumber(result, Math.round(total / 50) * 50, eur);
    }

    sliders.forEach((slider) => slider.addEventListener('input', update));
    update();
  }
</script>

<style>
  /* 44px raakvlak met een visueel dunne schuif: de duim heeft ruimte,
     het ontwerp verandert niet. */
  .calc-range {
    height: 44px;
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
  }
  .calc-range::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 3px;
    background: var(--color-line);
  }
  .calc-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 28px;
    height: 28px;
    margin-top: -11px;
    border-radius: 50%;
    background: var(--accent);
  }
  .calc-range::-moz-range-track {
    height: 6px;
    border-radius: 3px;
    background: var(--color-line);
  }
  .calc-range::-moz-range-thumb {
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
