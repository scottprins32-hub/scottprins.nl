---
/**
 * Demo 1 — Online agenda: behandeling → behandelaar → tijdstip → bevestiging.
 * Volledig nep-data, maar de flow is exact wat een klant zou doorlopen.
 */
import { demoAgenda } from '../../data/site';
---

<div class="rounded-2xl border border-line bg-white p-5 shadow-card sm:p-7" data-agenda>
  <div class="flex items-center justify-between gap-4">
    <p class="font-semibold">{demoAgenda.businessName}</p>
    <ol class="flex gap-1.5" aria-hidden="true">
      {demoAgenda.stepLabels.map(() => (
        <li class="step-dot h-1.5 w-6 rounded-full bg-cream-dim transition-colors" data-step-dot></li>
      ))}
    </ol>
  </div>

  {/* Stap 1 — behandeling */}
  <fieldset class="mt-5" data-agenda-step="0">
    <legend class="text-muted text-sm font-medium">{demoAgenda.stepLabels[0]}</legend>
    <div class="mt-3 grid gap-2.5">
      {
        demoAgenda.treatments.map((t) => (
          <button
            type="button"
            class="option-btn flex items-baseline justify-between gap-3 rounded-xl border border-line px-4 py-3 text-left transition-colors hover:border-accent"
            data-pick-treatment
            data-name={t.name}
          >
            <span class="font-medium">{t.name}</span>
            <span class="text-muted text-sm whitespace-nowrap">{t.duration} · {t.price}</span>
          </button>
        ))
      }
    </div>
  </fieldset>

  {/* Stap 2 — behandelaar */}
  <fieldset class="mt-5 hidden" data-agenda-step="1">
    <legend class="text-muted text-sm font-medium">{demoAgenda.stepLabels[1]}</legend>
    <div class="mt-3 grid gap-2.5 sm:grid-cols-3">
      {
        demoAgenda.therapists.map((p) => (
          <button
            type="button"
            class="option-btn rounded-xl border border-line px-4 py-3 text-left transition-colors hover:border-accent"
            data-pick-therapist
            data-name={p.name}
          >
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent/10 font-semibold text-accent">
              {p.name[0]}
            </span>
            <span class="mt-2 block font-medium">{p.name}</span>
            <span class="text-muted block text-xs">{p.role}</span>
          </button>
        ))
      }
    </div>
  </fieldset>

  {/* Stap 3 — tijdstip */}
  <fieldset class="mt-5 hidden" data-agenda-step="2">
    <legend class="text-muted text-sm font-medium">{demoAgenda.stepLabels[2]} — morgen</legend>
    <div class="mt-3 grid grid-cols-3 gap-2.5">
      {
        demoAgenda.slots.map((slot) => (
          <button
            type="button"
            class="option-btn rounded-xl border border-line px-3 py-2.5 text-center font-medium tabular-nums transition-colors hover:border-accent"
            data-pick-slot
            data-name={slot}
          >
            {slot}
          </button>
        ))
      }
    </div>
  </fieldset>

  {/* Bevestiging */}
  <div class="mt-5 hidden text-center" data-agenda-step="3" aria-live="polite">
    <span
      class="confirm-check mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-accent text-3xl text-white"
      aria-hidden="true">✓</span
    >
    <h3 class="font-display mt-4 text-xl font-semibold">{demoAgenda.confirmTitle}</h3>
    <p class="text-muted mx-auto mt-2 max-w-sm text-sm" data-agenda-summary></p>
    <p class="text-muted mx-auto mt-2 max-w-sm text-sm">{demoAgenda.confirmText}</p>
    <button
      type="button"
      class="mt-4 rounded-xl border border-line px-4 py-2 text-sm font-medium transition-colors hover:border-accent"
      data-agenda-restart>{demoAgenda.restart}</button
    >
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .confirm-check {
      animation: confirm-pop 0.45s cubic-bezier(0.22, 1.4, 0.4, 1) both;
    }
    @keyframes confirm-pop {
      from {
        transform: scale(0.3);
        opacity: 0;
      }
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-agenda]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-agenda-step]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-step-dot]')];
    const summary = root.querySelector<HTMLElement>('[data-agenda-summary]')!;
    const picked: string[] = [];

    function showStep(index: number): void {
      steps.forEach((step, i) => step.classList.toggle('hidden', i !== index));
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-accent', i <= index && index < 3);
        dot.classList.toggle('bg-cream-dim', i > index || index === 3);
      });
      if (index === 3) {
        summary.textContent = `${picked[0]} with ${picked[1]}, tomorrow at ${picked[2]}.`;
      }
    }

    const wire = (selector: string, nextStep: number) => {
      for (const btn of root.querySelectorAll<HTMLButtonElement>(selector)) {
        btn.addEventListener('click', () => {
          picked[nextStep - 1] = btn.dataset.name ?? '';
          showStep(nextStep);
        });
      }
    };
    wire('[data-pick-treatment]', 1);
    wire('[data-pick-therapist]', 2);
    wire('[data-pick-slot]', 3);

    root.querySelector('[data-agenda-restart]')!.addEventListener('click', () => {
      picked.length = 0;
      showStep(0);
    });
  }
</script>
