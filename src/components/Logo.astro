---
/**
 * SCOTTPRINS-woordmerk met het </>-beeldmerk uit Scotts design system.
 * De kleur volgt de tekstkleur van de omgeving (currentColor); het
 * accent-bolletje kleurt mee met de accentkleur van de site.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['logo', className]} role="img" aria-label="Scott Prins">
  <svg
    viewBox="0 0 44 28"
    class="logo-mark"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {/* < */}
    <path d="M10 5 3 14l7 9"></path>
    {/* / */}
    <path d="M21 4 15 24"></path>
    {/* nodes die samen een > vormen */}
    <path d="M27 7.5 38 14l-11 6.5" stroke-width="1.6" opacity="0.45"></path>
    <circle cx="27" cy="7.5" r="2.7" fill="var(--color-signal)" stroke="none"></circle>
    <circle cx="38" cy="14" r="2.7" fill="currentColor" stroke="none"></circle>
    <circle cx="27" cy="20.5" r="2.7" fill="currentColor" stroke="none"></circle>
  </svg>
  <span class="logo-word" aria-hidden="true">Scott<b>Prins</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    line-height: 1;
    white-space: nowrap;
  }
  .logo-mark {
    width: auto;
    height: 1.25rem;
    flex: none;
  }
  .logo-word {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .logo-word b {
    font-weight: 700;
  }
</style>
