---
/**
 * Een nieuwe voorbeeldsite op ware grootte (/voorbeeld/bakker/ enz.).
 * De naam komt uit de hash (#Bakkerij%20Prins), zodat Scott een prospect
 * een link met de eigen naam erin kan sturen. De hash gaat nooit naar een
 * server. Onderaan een smalle balk van Scott: dit is een voorbeeld, en zo
 * claim je hem.
 */
import { content, toLocale, altPath } from '../data/content';
import { SAMPLE_NAMES, type TradeId } from '../data/trade-ids';
import { url } from '../lib/url';
import SiteAfter from './upgrade/SiteAfter.astro';
import Icon from './Icon.astro';
import '../styles/sites.css';

interface Props {
  trade: TradeId;
}
const { trade } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = content(locale);
const v = t.voorbeeld;
const home = url(altPath('/', locale));
---

<main id="main" class="vb" data-voorbeeld data-trade={trade} data-suffix={v.titleSuffix}>
  <div class="vb-site">
    <SiteAfter trade={trade} name={SAMPLE_NAMES[trade]} mode="page" eager />
  </div>
</main>

<aside class="vb-bar" aria-label={v.badge}>
  <span class="vb-badge">{v.badge}</span>
  <p class="vb-note">{v.note}</p>
  <a class="vb-back" href={`${home}#upgrade`}>
    <Icon name="arrow-left" />
    <span>{v.back}</span>
  </a>
  <a class="btn btn-signal vb-claim" href={`${home}#bestellen`}>
    {v.claim}<Icon name="arrow-right" />
  </a>
</aside>

<script>
  import { siteIntro } from '../scripts/site-intro';
  import { reducedMotion } from '../scripts/motion/core';
  import { currentName, setState } from '../scripts/state';
  import { isTradeId } from '../data/trade-ids';

  const root = document.querySelector<HTMLElement>('[data-voorbeeld]');
  if (root) {
    /* De naam uit de link (#naam) wint; anders wat je eerder in dit
       tabblad typte. */
    const fromHash = decodeURIComponent(location.hash.slice(1)).trim();
    const trade = root.dataset.trade;
    if (isTradeId(trade)) setState({ trade });
    if (fromHash) setState({ typed: fromHash });
    const name = currentName();
    for (const el of root.querySelectorAll<HTMLElement>('[data-naam]')) el.textContent = name;
    document.title = `${name} | ${root.dataset.suffix ?? ''}`;
    const site = root.querySelector<HTMLElement>('.new');
    if (site && !reducedMotion()) siteIntro(site);
  }
</script>

<style>
  .vb {
    min-height: 100svh;
  }
  .vb-site {
    container: vp / inline-size;
    padding-bottom: 5.5rem;
    background: var(--color-ink);
  }
  .vb-bar {
    position: fixed;
    left: 50%;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.75rem 1.25rem;
    width: min(calc(100% - 1.5rem), 60rem);
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-radius: 999px;
    background: var(--color-ink-3);
    box-shadow:
      0 0 0 1px var(--color-line-strong),
      0 18px 40px -12px rgb(0 0 0 / 0.6);
    color: var(--color-bone);
    transform: translateX(-50%);
  }
  .vb-badge {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-signal-text);
  }
  .vb-note {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-bone-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vb-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    margin-left: auto;
    color: var(--color-bone-2);
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .vb-back:hover {
    color: var(--color-bone);
  }
  .vb-back :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .vb-claim {
    flex: none;
    min-height: 2.75rem;
  }
  @media (max-width: 52rem) {
    .vb-note {
      display: none;
    }
  }
  @media (max-width: 30rem) {
    /* Alleen het pijltje in beeld, de tekst blijft voor schermlezers. */
    .vb-back span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .vb-badge {
      font-size: 0.625rem;
    }
  }
</style>
