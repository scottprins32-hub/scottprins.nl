---
/**
 * De intro in drie bedrijven:
 * 1. Bij het laden: geen zwart gat maar een logo-splash die vanzelf
 *    wegvloeit, waarna het lege browserframe "de site" opent.
 * 2. Tijdens het scrollen (gepind, ±5 scrolls): de site bouwt zichzelf
 *    op uit herkenbare stukken van déze site (HeroScene), met alleen
 *    een klein dag-label als tekst (Dag 1 — schets … Dag 5 — live).
 * 3. Op het eind: de scène dimt, de kopregel + optie-11-caption komen erover.
 *
 * Wie scrolt terwijl de splash nog speelt, krijgt geen wachttijd: de
 * intro spoelt dan direct door naar het einde en de scrub neemt over.
 * Zonder JavaScript of met reduced motion staat hier het statische
 * eindbeeld: kopregel + caption + afgebouwde mini-site.
 */
import { hero } from '../data/site';
import HeroScene from './HeroScene.astro';
import Logo from './Logo.astro';
---

<section class="hero grain relative bg-ink text-cream" data-hero>
  <div class="relative flex h-svh flex-col items-center justify-center overflow-hidden px-5">
    <Logo class="absolute top-5 left-5 z-20 sm:top-7 sm:left-7" data-hero-corner-logo />

    {/* Splash bij binnenkomst — alleen in de geanimeerde variant */}
    <div
      class="hero-splash pointer-events-none absolute inset-0 z-30 flex-col items-center justify-center gap-4"
      data-hero-splash
      aria-hidden="true"
    >
      <Logo class="scale-[1.8] sm:scale-[2.2]" />
      <p class="mt-4 text-xs tracking-[0.3em] text-muted-dark uppercase">Webdesign · Nederland</p>
    </div>

    {/* De mini-site die zichzelf opbouwt */}
    <div class="hero-scene-wrap w-full max-w-2xl opacity-40" data-hero-scene>
      <HeroScene />
    </div>

    {/* Eindbeeld: kopregel over de gedimde scène */}
    <h1
      class="font-display text-display absolute inset-x-0 top-1/2 z-10 mx-auto max-w-4xl px-5 text-center font-semibold text-balance"
      data-hero-headline
    >
      {hero.headline}
    </h1>

    {/* Dag-labels: het enige tekstje tijdens de bouw-animatie. */}
    <div class="hero-days absolute bottom-24 left-1/2 z-10 -translate-x-1/2" aria-hidden="true">
      {
        hero.days.map((day, i) => {
          const [dag, stap] = day.split(' — ');
          return (
            <span
              class="day-chip col-start-1 row-start-1 rounded-full bg-ink-soft/90 px-4 py-2 text-xs font-semibold tracking-widest whitespace-nowrap uppercase ring-1 ring-white/10"
              data-day={i}
            >
              <span class="text-accent-soft">{dag}</span>
              <span class="text-muted-dark"> — {stap}</span>
            </span>
          );
        })
      }
    </div>

    {/* Dit regeltje leert de bezoeker hoe de hele site werkt. */}
    <a
      class="absolute bottom-12 left-1/2 z-10 w-max max-w-[92vw] -translate-x-1/2 rounded-full bg-ink-soft/90 px-5 py-2.5 text-center text-sm font-medium text-cream ring-1 ring-white/15 transition-colors hover:ring-accent"
      href={`#${hero.captionTargetId}`}
      data-hero-caption>{hero.caption}</a
    >

    <p
      class="hero-hint absolute bottom-4 left-1/2 z-10 -translate-x-1/2 text-xs tracking-widest text-muted-dark uppercase"
      data-hero-hint
      aria-hidden="true"
    >
      {hero.scrollHint} ↓
    </p>
  </div>
</section>

<style>
  [data-hero-headline] {
    text-shadow: 0 2px 28px rgb(11 14 17 / 0.85);
    /* Verticaal centreren; in de geanimeerde variant neemt GSAP dit over
       via yPercent zodat de y-tween ermee kan combineren. */
    transform: translateY(-50%);
  }
  /* Statische variant (no-JS / reduced motion): geen splash/dag-labels/hint. */
  .hero-splash,
  .hero-days,
  .hero-hint {
    display: none;
  }
  .hero--animated .hero-splash {
    display: flex;
  }
  /* Geanimeerde variant: labels gestapeld in één grid-cel voor de crossfade. */
  .hero--animated .hero-days {
    display: grid;
  }
  .hero--animated .hero-hint {
    display: block;
  }
</style>

<script>
  import { gsap, NO_PREFERENCE, ScrollTrigger } from '../scripts/motion';
  import { buildSceneTimeline } from '../scripts/scene-timeline';

  const section = document.querySelector<HTMLElement>('[data-hero]');
  if (section) {
    const splash = section.querySelector<HTMLElement>('[data-hero-splash]')!;
    const sceneWrap = section.querySelector<HTMLElement>('[data-hero-scene]')!;
    const sceneRoot = sceneWrap.querySelector<HTMLElement>('[data-scene-root]')!;
    const cornerLogo = section.querySelector<HTMLElement>('[data-hero-corner-logo]')!;
    const headline = section.querySelector<HTMLElement>('[data-hero-headline]')!;
    const days = [...section.querySelectorAll<HTMLElement>('[data-day]')];
    const caption = section.querySelector<HTMLElement>('[data-hero-caption]')!;
    const hint = section.querySelector<HTMLElement>('[data-hero-hint]')!;

    // De scène-opbouw beslaat het eerste deel van de scrub; daarna maakt
    // hij plaats voor de kopregel (het "live"-moment).
    const SCENE_END = 0.88;

    const mm = gsap.matchMedia();

    mm.add(NO_PREFERENCE, () => {
      section.classList.add('hero--animated');

      const sceneTl = buildSceneTimeline(sceneRoot);
      gsap.set(headline, { yPercent: -50 });
      gsap.set([headline, caption, ...days], { autoAlpha: 0 });
      gsap.set([sceneWrap, cornerLogo, hint], { autoAlpha: 0 });

      // --- Bedrijf 1: splash bij het laden (tijd-gestuurd, niet scroll) ---
      const intro = gsap.timeline();
      intro
        .fromTo(
          splash,
          { autoAlpha: 0, scale: 0.92 },
          { autoAlpha: 1, scale: 1, duration: 0.55, ease: 'power2.out' },
        )
        .to(splash, { autoAlpha: 0, y: -28, duration: 0.45, ease: 'power2.in' }, '+=0.75')
        .fromTo(
          sceneWrap,
          { scale: 0.94 },
          { autoAlpha: 1, scale: 1, duration: 0.55, ease: 'power2.out' },
          '-=0.12',
        )
        .to([cornerLogo, hint], { autoAlpha: 1, duration: 0.35 }, '<+=0.2');

      // --- Bedrijf 2+3: de scroll-scrub ---
      sceneTl.duration(SCENE_END);
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: '+=450%',
          pin: true,
          scrub: 0.6,
          anticipatePin: 1,
          // Scrolt iemand tijdens de splash? Spoel de intro dan door,
          // zodat de scrub nooit tegen de intro in zit te vechten.
          onUpdate: (self) => {
            if (self.progress > 0.005 && intro.progress() < 1) intro.progress(1);
          },
        },
      });

      tl.add(sceneTl.play(), 0);
      tl.to(hint, { autoAlpha: 0, duration: 0.03 }, 0.03);

      // Vijf dag-labels, netjes verdeeld over de bouw-fase.
      days.forEach((chip, i) => {
        const start = 0.02 + i * (SCENE_END / days.length);
        tl.fromTo(chip, { y: 14 }, { autoAlpha: 1, y: 0, duration: 0.03 }, start);
        tl.to(chip, { autoAlpha: 0, y: -14, duration: 0.03 }, start + SCENE_END / days.length - 0.035);
      });

      // "Live": scène dimt tot achtergrond, kopregel + caption verschijnen.
      tl.to(sceneWrap, { opacity: 0.3, scale: 0.96, duration: 0.08 }, SCENE_END)
        .fromTo(headline, { y: 28 }, { autoAlpha: 1, y: 0, duration: 0.08 }, SCENE_END + 0.02)
        .fromTo(caption, { y: 16 }, { autoAlpha: 1, y: 0, duration: 0.06 }, SCENE_END + 0.06);

      return () => {
        section.classList.remove('hero--animated');
        intro.kill();
        sceneTl.kill();
        gsap.set([headline, caption, hint, cornerLogo, sceneWrap, splash, ...days], {
          clearProps: 'all',
        });
      };
    });

    // Reduced motion: geen splash, geen pin — het afgebouwde eindbeeld
    // staat er al (de statische HTML-toestand), dus niets te doen.
  }
</script>
