---
/**
 * De nieuwe voorbeeldsite, één ontwerp per branche (data-look).
 *
 * mode 'device': binnen het upgrade-ding. De laag is inert, dus de kop is
 *                geen heading.
 * mode 'page'  : op /voorbeeld/, als echte pagina met een h1.
 *
 * Knoppen zijn in beide gevallen spans: het is een voorbeeldzaak, er valt
 * niets te bestellen, en een link die nergens heen gaat is erger dan geen.
 */
import { Image } from 'astro:assets';
import { content, toLocale } from '../../data/content';
import { tradePhotos, type TradeId } from '../../data/trades';
import { tail } from '../../lib/text';

interface Props {
  trade: TradeId;
  name: string;
  mode?: 'device' | 'page';
  eager?: boolean;
}
const { trade, name, mode = 'device', eager = false } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = content(locale);
const a = t.trades[trade].after;
const page = mode === 'page';
const Title = page ? 'h1' : 'p';
/* Per woord, zodat de kop natuurlijk afbreekt en per woord kan binnenkomen. */
const words = (text: string) => text.split(/\s+/).filter(Boolean);
/* 'voordat je binnen bent.' krijgt een spatie, een los '.' niet. */
const endSpace = tail(a.titleEnd).startsWith(' ');
---

<div class:list={['new', { 'is-page': page }]} data-look={trade}>
  <div class="new-head">
    <span class="new-logo" data-naam>{name}</span>
    <div class="new-nav">
      {a.nav.map((item) => <span>{item}</span>)}
    </div>
    <span class="new-navcta">{a.navCta}</span>
    <span class="new-burger" aria-hidden="true"></span>
  </div>
  <div class="new-hero">
    <div class="new-copy">
      <p class="new-eyebrow" data-a="eyebrow"><span data-naam>{name}</span> · {a.eyebrow}</p>
      <Title class="new-title" data-a="title">
        {words(a.titleStart).map((w) => <><span class="w">{w}</span>{' '}</>)}<em
          >{words(a.titleAccent).map((w, i, all) => <><span class="w">{w}</span>{i < all.length - 1 && ' '}</>)}</em
        >{endSpace && ' '}{words(a.titleEnd).map((w, i, all) => <><span class="w">{w}</span>{i < all.length - 1 && ' '}</>)}
      </Title>
      <p class="new-sub" data-a="sub">{a.sub}</p>
      <div class="new-ctas" data-a="ctas">
        <span class="new-btn">{a.cta}</span>
        <span class="new-btn2">{a.cta2}</span>
      </div>
    </div>
    <figure class="new-media" data-a="media">
      <Image
        src={tradePhotos[trade].after}
        alt={page ? a.alt : ''}
        widths={[480, 960]}
        sizes={page ? '(min-width: 700px) 50vw, 100vw' : '(min-width: 1024px) 560px, 92vw'}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager && page ? 'high' : undefined}
        decoding="async"
      />
    </figure>
  </div>
  <ul class="new-facts" data-a="facts">
    {a.facts.map((fact) => <li>{fact}</li>)}
  </ul>
  {
    page && (
      <>
        <div class="new-more">
          <h2>{t.oldSite.hours}</h2>
          <table class="new-hours">
            <tbody>
              {t.oldSite.hoursRows.map(([dag, tijd]) => (
                <tr>
                  <td>{dag}</td>
                  <td>{tijd}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="new-foot">
          © {new Date().getFullYear()} <span data-naam>{name}</span>
        </div>
      </>
    )
  }
</div>
