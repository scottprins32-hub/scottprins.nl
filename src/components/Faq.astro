---
/**
 * Vragen, als native <details>: werkt zonder JavaScript en met elk
 * hulpmiddel. Openklappen beweegt waar de browser dat kan
 * (interpolate-size), anders gaat het gewoon meteen open.
 */
import { content, toLocale } from '../data/content';
import Icon from './Icon.astro';

const { faq } = content(toLocale(Astro.currentLocale));
---

<section class="faq section-pad" id="vragen" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-head">
      <p class="label faq-label">{faq.label}</p>
      <h2 id="faq-title" class="display faq-title" data-reveal="title">{faq.title}</h2>
    </div>
    <div class="faq-list">
      {
        faq.items.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.q}</span>
              <Icon name="plus" class="icon faq-icon" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    border-top: 1px solid var(--color-line);
  }
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 2vw, 2rem);
  }
  .faq-head,
  .faq-list {
    grid-column: 1 / -1;
  }
  .faq-label {
    margin: 0 0 1.25rem;
    color: var(--color-mute);
  }
  .faq-title {
    margin: 0;
    font-size: var(--text-display-l);
  }
  .faq-list {
    border-top: 1px solid var(--color-line);
  }
  .faq-item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-weight: 600;
    font-stretch: 106%;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary:hover {
    color: var(--color-bone);
  }
  .faq-item :global(.faq-icon) {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    color: var(--color-signal-text);
    transition: transform 0.45s var(--ease-out-expo);
  }
  .faq-item[open] :global(.faq-icon) {
    transform: rotate(45deg);
  }
  .faq-item p {
    max-width: 44rem;
    margin: 0;
    padding: 0 0 1.5rem;
    color: var(--color-bone-2);
  }
  @supports (interpolate-size: allow-keywords) {
    .faq-item {
      interpolate-size: allow-keywords;
    }
    .faq-item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 0.55s var(--ease-out-expo),
        content-visibility 0.55s allow-discrete;
    }
    .faq-item[open]::details-content {
      block-size: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content,
    .faq-item :global(.faq-icon) {
      transition: none;
    }
  }
  @media (min-width: 64rem) {
    .faq-head {
      grid-column: 1 / span 4;
      align-self: start;
      position: sticky;
      top: 7rem;
    }
    .faq-list {
      grid-column: 6 / -1;
    }
  }
</style>
