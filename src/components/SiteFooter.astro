---
/**
 * Footer met de grote "samenwerken?"-uitnodiging en de bedrijfsgegevens.
 * ({BTW} nog vervangen vóór livegang; adresvelden in site.ts invullen
 * zodra Scott ze aanlevert — leeg = niet tonen.)
 */
import { site } from '../data/site';
import { content, toLocale, altPath } from '../data/content';
const locale = toLocale(Astro.currentLocale);
const { footer } = content(locale);
import Logo from './Logo.astro';
---

<footer class="grain bg-ink py-16 text-cream sm:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
      <div class="max-w-xl">
        <Logo class="mb-6" />
        <p class="kicker">{footer.kicker}</p>
        <p class="font-display mt-2 text-3xl font-semibold text-balance sm:text-4xl">{footer.cta}</p>
        <p class="text-muted-dark mt-3">{footer.sub}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="#configurator"
            class="rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
          >
            {footer.ctaButton}
          </a>
          <a
            href={`https://wa.me/${site.whatsapp}`}
            target="_blank"
            rel="noopener"
            class="rounded-xl border border-white/25 px-5 py-3 text-sm font-semibold transition-colors hover:border-accent"
          >
            💬 WhatsApp
          </a>
        </div>
      </div>
      <div class="text-muted-dark text-sm leading-relaxed sm:text-right">
        <p class="font-semibold text-cream">{site.legalName}</p>
        <p>
          <a href={`mailto:${site.email}`} class="underline-offset-2 hover:text-cream hover:underline">{site.email}</a>
        </p>
        <p>
          {footer.phoneLine}
          <a href={`tel:+${site.whatsapp}`} class="underline-offset-2 hover:text-cream hover:underline">
            {site.whatsappDisplay}
          </a>
        </p>
        {site.addressStreet && <p class="mt-2">{site.addressStreet}</p>}
        {site.addressCity && <p>{site.addressCity}</p>}
        {/* De btw-regel verschijnt pas als er een echt nummer staat; een
            zichtbare {BTW}-placeholder is erger dan geen btw-regel. */}
        <p class="mt-2">
          {footer.kvkLabel}: {footer.kvk}
          {!footer.btw.startsWith('{') && ` · ${footer.btwLabel}: ${footer.btw}`}
        </p>
      </div>
    </div>

    <div class="text-muted-dark mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs">
      <p>{footer.rights}</p>
      <div class="flex flex-wrap gap-4">
        <a href={altPath('/voorwaarden', locale)} class="underline-offset-2 hover:text-cream hover:underline">
          {footer.termsLink}
        </a>
        <a href={altPath('/privacy', locale)} class="underline-offset-2 hover:text-cream hover:underline">
          {footer.privacyLink}
        </a>
      </div>
    </div>
  </div>
</footer>
