---
/** Footer met bedrijfsgegevens ({BTW} nog vervangen vóór livegang). */
import { footer, site } from '../data/site';
---

<footer class="grain bg-ink py-14 text-cream">
  <div class="mx-auto max-w-6xl px-5">
    <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
      <div>
        <p class="font-display text-2xl font-semibold">{footer.cta}</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a
            href="#configurator"
            class="rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
          >
            Stel je website samen
          </a>
          <a
            href={`https://wa.me/${site.whatsapp}`}
            target="_blank"
            rel="noopener"
            class="rounded-xl border border-white/25 px-5 py-3 text-sm font-semibold transition-colors hover:border-accent"
          >
            💬 WhatsApp
          </a>
        </div>
      </div>
      <div class="text-muted-dark text-sm leading-relaxed sm:text-right">
        <p class="font-semibold text-cream">{site.legalName}</p>
        <p>
          <a href={`mailto:${site.email}`} class="underline-offset-2 hover:text-cream hover:underline">{site.email}</a>
        </p>
        <p>WhatsApp: {site.whatsappDisplay}</p>
        <p class="mt-2">{footer.kvkLabel}: {footer.kvk} · {footer.btwLabel}: {footer.btw}</p>
      </div>
    </div>

    <div class="text-muted-dark mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs">
      <p>{footer.rights}</p>
      <a href="/privacy" class="underline-offset-2 hover:text-cream hover:underline">{footer.privacyLink}</a>
    </div>
  </div>
</footer>
