---
/**
 * Mini-preview van de demo Fysio Vesting: kies een moment → bevestiging.
 * Nagebouwd (geen iframe, geen screenshot) zodat hij klikbaar blijft en niet
 * veroudert. De echte demo staat één knop verderop.
 */
import { showcasePreview } from '../../data/site';

const { fysio } = showcasePreview;
---

<div class="rounded-xl border border-line bg-cream-dim/60 p-4" data-pv-fysio>
  <div class="flex items-baseline justify-between gap-3">
    <p class="text-sm font-semibold">{fysio.heading}</p>
    <p class="text-muted text-xs">{fysio.sub}</p>
  </div>

  <div data-pv-picker>
    <div class="mt-3 flex gap-2" role="group" aria-label="Kies een dag">
      {
        fysio.days.map((day, i) => (
          <button
            type="button"
            class="pv-day rounded-lg border border-line bg-white px-3 py-1.5 text-xs font-medium transition-colors"
            data-pv-day={day.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {day.label}
          </button>
        ))
      }
    </div>

    {
      fysio.days.map((day, i) => (
        <div class="mt-3 flex flex-wrap gap-2" data-pv-slots={day.id} hidden={i !== 0}>
          {day.slots.map((slot) => (
            <button
              type="button"
              class="rounded-lg border border-line bg-white px-3 py-1.5 text-xs font-medium transition-colors hover:border-accent hover:text-accent"
              data-pv-slot={slot}
            >
              {slot}
            </button>
          ))}
        </div>
      ))
    }
  </div>

  {/* aria-live: wie met een screenreader boekt, hoort de bevestiging ook. */}
  <div class="mt-3" data-pv-done hidden aria-live="polite">
    <p class="text-sm font-semibold text-accent">
      {fysio.confirmTitle} <span data-pv-when></span>
    </p>
    <p class="text-muted mt-1 text-xs leading-relaxed">{fysio.confirmText}</p>
    <button type="button" class="mt-2 text-xs font-medium underline underline-offset-4" data-pv-restart>
      {fysio.restart}
    </button>
  </div>
</div>

<style>
  .pv-day[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
</style>

<script>
  import { showcasePreview } from '../../data/site';

  const root = document.querySelector<HTMLElement>('[data-pv-fysio]');
  if (root) {
    const picker = root.querySelector<HTMLElement>('[data-pv-picker]')!;
    const done = root.querySelector<HTMLElement>('[data-pv-done]')!;
    const when = root.querySelector<HTMLElement>('[data-pv-when]')!;
    const days = [...root.querySelectorAll<HTMLButtonElement>('[data-pv-day]')];

    function showDay(id: string): void {
      for (const btn of days) btn.setAttribute('aria-pressed', String(btn.dataset.pvDay === id));
      for (const group of root!.querySelectorAll<HTMLElement>('[data-pv-slots]')) {
        group.hidden = group.dataset.pvSlots !== id;
      }
    }

    for (const btn of days) {
      btn.addEventListener('click', () => showDay(btn.dataset.pvDay!));
    }

    for (const slot of root.querySelectorAll<HTMLButtonElement>('[data-pv-slot]')) {
      slot.addEventListener('click', () => {
        const day = showcasePreview.fysio.days.find(
          (d) => d.id === days.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.pvDay,
        );
        when.textContent = `${day?.label ?? ''} om ${slot.dataset.pvSlot}.`;
        picker.hidden = true;
        done.hidden = false;
      });
    }

    root.querySelector<HTMLButtonElement>('[data-pv-restart]')!.addEventListener('click', () => {
      done.hidden = true;
      picker.hidden = false;
      showDay(showcasePreview.fysio.days[0].id);
    });
  }
</script>
