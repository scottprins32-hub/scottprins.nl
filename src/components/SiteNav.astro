---
/**
 * Vaste navigatie. Schuift weg bij naar beneden scrollen en komt terug bij
 * omhoog scrollen; met toetsenbordfocus erin blijft hij altijd staan.
 * Op de telefoon opent het menu als <dialog>: focus blijft erin en Esc
 * sluit hem, zonder eigen focus-val.
 */
import { site } from '../data/site';
import { content, toLocale, altPath } from '../data/content';
import { url } from '../lib/url';
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import Icon from './Icon.astro';

interface Props {
  /** Op de homepage zijn de ankers lokaal (#prijs); elders wijzen ze naar de homepage. */
  home?: boolean;
}
const { home = true } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const { nav } = content(locale);
const homeUrl = url(altPath('/', locale));
const href = (hash: string) => (home ? hash : `${homeUrl}${hash}`);
---

<header class="nav" data-site-nav>
  <div class="wrap nav-inner">
    <a class="nav-home" href={home ? '#main' : homeUrl} aria-label={nav.home}>
      <Logo />
    </a>
    <nav class="nav-links" aria-label={nav.label}>
      <ul>
        {
          nav.links.map((link) => (
            <li>
              <a href={href(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav-end">
      <LangSwitch class="nav-lang" />
      <a class="btn btn-signal nav-cta" href={href('#bestellen')} data-magnetic>{nav.cta}</a>
      <button type="button" class="nav-menu" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
        <Icon name="list" />
        <span>{nav.menu}</span>
      </button>
    </div>
  </div>

  <dialog id="menu" class="menu" aria-label={nav.label} data-menu>
    <div class="menu-inner wrap">
      <div class="menu-top">
        <Logo />
        <button type="button" class="nav-menu" data-menu-close>
          <Icon name="x" />
          <span>{nav.close}</span>
        </button>
      </div>
      <nav aria-label={nav.label}>
        <ul class="menu-links">
          {
            nav.links.map((link) => (
              <li>
                <a href={href(link.href)} data-menu-link>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="menu-bottom">
        <a class="btn btn-signal" href={href('#bestellen')} data-menu-link>
          {nav.cta}<Icon name="arrow-right" />
        </a>
        <a class="menu-contact" href={`https://wa.me/${site.whatsapp}`} rel="noopener" target="_blank">
          <Icon name="whatsapp" />{site.whatsappDisplay}
        </a>
        <LangSwitch />
      </div>
    </div>
  </dialog>
</header>

<script>
  import { initNav } from '../scripts/nav';
  initNav();
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      transform 0.5s var(--ease-out-expo),
      background-color 0.3s,
      border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    background: rgb(18 17 15 / 0.94);
    border-bottom-color: var(--color-line);
  }
  .nav.is-hidden:not(:focus-within) {
    transform: translateY(-100%);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.5rem;
  }
  .nav-home {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-bone);
  }
  .nav-links {
    margin-left: auto;
  }
  .nav-links ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.85rem;
    color: var(--color-bone-2);
    font-size: 0.9375rem;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--color-bone);
  }
  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-cta {
    min-height: 2.75rem;
    padding: 0 1.15rem;
    font-size: 0.9375rem;
  }
  .nav-menu {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.25rem 0 0.5rem;
    border: 0;
    background: none;
    color: var(--color-bone);
    font: inherit;
    font-size: 0.9375rem;
  }
  .nav-menu :global(.icon) {
    width: 1.4rem;
    height: 1.4rem;
  }
  @media (max-width: 63.99rem) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .nav-end {
      margin-left: auto;
    }
    .nav-menu {
      display: inline-flex;
    }
  }

  /* ------------------------------------------------------------ menu -- */
  .menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-ink);
    color: var(--color-bone);
  }
  .menu::backdrop {
    background: var(--color-ink);
  }
  .menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
  }
  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
  }
  .menu-top .nav-menu {
    display: inline-flex;
  }
  .menu-links {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .menu-links a {
    display: block;
    padding: 0.35rem 0;
    font-size: clamp(2.25rem, 10vw, 3.5rem);
    font-weight: 720;
    font-stretch: 112%;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--color-bone);
  }
  .menu-bottom {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    margin-top: auto;
    padding-top: 2.5rem;
  }
  .menu-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    color: var(--color-bone-2);
  }
  .menu-contact :global(.icon) {
    width: 1.3rem;
    height: 1.3rem;
  }
</style>
