---
/**
 * Zwevende navigatie. Verschijnt pas zodra de bezoeker de hero voorbij is
 * (daar staan de knoppen al) en verdwijnt weer bovenaan. Zonder deze balk
 * is een one-pager van deze lengte een eenrichtingsstraat.
 *
 * Ook zonder JavaScript bruikbaar: dan staat hij gewoon altijd in beeld.
 */
import { site } from '../data/site';
import { content } from '../data/content';
const { nav } = content(Astro.currentLocale);
import LangSwitch from './LangSwitch.astro';
---

<header
  class="site-nav fixed inset-x-0 top-0 z-40 transition-transform duration-300 motion-reduce:transition-none"
  data-site-nav
>
  <nav
    class="mx-auto mt-3 flex w-[min(100%-1.5rem,72rem)] items-center gap-2 rounded-2xl bg-ink/90 px-3 py-2.5 ring-1 ring-white/12 backdrop-blur-md sm:gap-4 sm:px-4"
    aria-label={nav.menuLabel}
  >
    <a href="#main" class="font-display text-sm font-semibold tracking-[0.08em] whitespace-nowrap text-cream uppercase sm:tracking-[0.18em]">
      Scott<span class="text-accent">Prins</span>
    </a>

    <ul class="ml-auto hidden items-center gap-1 md:flex">
      {
        nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-lg px-3 py-2 text-sm font-medium text-muted-dark transition-colors hover:bg-white/8 hover:text-cream"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    {/* Sectiemenu voor mobiel. Een <details> werkt zonder JavaScript en
        houdt de 33 schermen navigeerbaar. */}
    <details class="relative ml-auto md:hidden" data-nav-menu>
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg text-cream [&::-webkit-details-marker]:hidden"
        aria-label={nav.menuLabel}
      >
        <span aria-hidden="true">☰</span>
      </summary>
      <ul class="absolute right-0 z-50 mt-2 w-56 rounded-xl bg-ink/95 p-2 ring-1 ring-white/15 backdrop-blur-md">
        {
          nav.links.map((link) => (
            <li>
              <a href={link.href} class="block rounded-lg px-3 py-3 text-sm text-cream hover:bg-white/8">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>

    <LangSwitch class="md:ml-0" />
    <a
      href={`https://wa.me/${site.whatsapp}`}
      target="_blank"
      rel="noopener"
      class="hidden rounded-lg px-2 py-2 text-sm font-medium text-muted-dark transition-colors hover:text-cream sm:inline sm:px-3"
    >
      <span aria-hidden="true">💬</span>
      {/* sr-only i.p.v. hidden: op mobiel blijft de naam voor schermlezers bestaan. */}
      <span class="sr-only sm:not-sr-only">WhatsApp</span>
    </a>
    <a
      href="#configurator"
      class="rounded-lg bg-accent px-3 py-2 text-sm font-semibold whitespace-nowrap text-white transition-opacity hover:opacity-90 sm:px-4"
    >
      {nav.cta}
    </a>
  </nav>
</header>

{/* De toon/verberg-regels staan in global.css: een selector die begint
    met `.js` (op <html>) overleeft Astro's scoping niet. */}

<script>
  const navEl = document.querySelector<HTMLElement>('[data-site-nav]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (navEl && hero) {
    /*
     * Bewust géén ScrollTrigger en geen IntersectionObserver: de hero
     * wordt gepind, en beide zijn dan gevoelig voor het moment waarop ze
     * meten (module-vololgorde, of een hero die nog geen hoogte heeft).
     * Eén meting per frame op de échte positie is simpel en klopt altijd:
     * zolang de onderkant van de hero nog in beeld is — ook tijdens de
     * pin — blijft de balk weg.
     */
    let queued = false;
    const update = () => {
      queued = false;
      navEl.toggleAttribute('data-visible', hero.getBoundingClientRect().bottom <= 60);
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  } else {
    navEl?.setAttribute('data-visible', '');
  }

  /* Menu dichtklappen zodra er een sectie gekozen is. */
  const menu = document.querySelector<HTMLDetailsElement>('[data-nav-menu]');
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.open = false;
    }),
  );
</script>
