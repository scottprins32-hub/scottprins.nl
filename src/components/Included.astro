---
/**
 * Wat je krijgt. Geen kaartjes op een rij: een lijst met woorden die
 * zwaar genoeg zijn om zelf het werk te doen.
 */
import { content, toLocale } from '../data/content';

const { included } = content(toLocale(Astro.currentLocale));
---

<section class="included section-pad" aria-labelledby="included-title">
  <div class="wrap included-grid">
    <div class="included-head">
      <p class="label included-label">{included.label}</p>
      <h2 id="included-title" class="display included-title" data-reveal="title">{included.title}</h2>
      <p class="lead included-lead" data-reveal="up">{included.lead}</p>
    </div>
    <dl class="included-list">
      {
        included.items.map((item) => (
          <div class="included-item" data-reveal="up">
            <dt>{item.term}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .included {
    border-top: 1px solid var(--color-line);
  }
  .included-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 2vw, 2rem);
  }
  .included-head,
  .included-list {
    grid-column: 1 / -1;
  }
  .included-label {
    margin: 0 0 1.25rem;
    color: var(--color-mute);
  }
  .included-title {
    margin: 0;
    font-size: var(--text-display-l);
  }
  .included-lead {
    max-width: 30rem;
    margin: 1.5rem 0 0;
    color: var(--color-bone-2);
  }
  .included-list {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
  }
  .included-item {
    display: grid;
    gap: 0.5rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--color-line);
  }
  .included-item dt {
    font-size: clamp(1.35rem, 2.1vw, 1.75rem);
    font-weight: 650;
    font-stretch: 110%;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .included-item dd {
    margin: 0;
    max-width: 34rem;
    color: var(--color-bone-2);
  }
  @media (min-width: 48rem) {
    .included-list {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
  }
  @media (min-width: 64rem) {
    .included-head {
      grid-column: 1 / span 5;
      align-self: start;
      position: sticky;
      top: 7rem;
    }
    .included-list {
      grid-column: 6 / -1;
    }
  }
</style>
