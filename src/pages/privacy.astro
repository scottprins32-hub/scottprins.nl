---
/** Privacyverklaring — statisch, zonder JavaScript. Tekst in site.ts. */
import Base from '../layouts/Base.astro';
import { privacy, site } from '../data/site';
---

<Base
  title={`${privacy.title} — ${site.legalName}`}
  description={`Privacyverklaring van ${site.legalName}: welke gegevens het offerteformulier verwerkt, waarom, en wat jouw rechten zijn.`}
  path="/privacy"
>
  <main id="main" class="bg-cream text-ink min-h-screen">
    <div class="mx-auto max-w-2xl px-5 py-16 sm:py-24">
      <a href="/" class="text-muted text-sm font-medium hover:text-accent">{privacy.backLink}</a>
      <h1 class="font-display text-h2 mt-6 font-semibold">{privacy.title}</h1>
      <p class="text-muted mt-2 text-sm">{privacy.updated}</p>
      <p class="text-lead mt-8">{privacy.intro}</p>

      {
        privacy.sections.map((section) => (
          <section class="mt-10">
            <h2 class="font-display text-h3 font-semibold">{section.title}</h2>
            {section.body.map((paragraph) => (
              <p class="text-ink/80 mt-3 leading-relaxed">{paragraph}</p>
            ))}
          </section>
        ))
      }

      <p class="border-line text-muted mt-14 border-t pt-6 text-sm">
        {site.legalName} · <a href="/" class="underline hover:text-accent">{site.url.replace('https://', '')}</a>
      </p>
    </div>
  </main>
</Base>
