---
/** Engelse algemene voorwaarden. Zelfde inhoud als /voorwaarden, andere taal. */
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { legal } from '../../data/content';
import TermsPage from '../../components/TermsPage.astro';
const { voorwaarden } = legal(Astro.currentLocale);
---

<Base
  title={`${voorwaarden.title} — ${site.legalName}`}
  description={voorwaarden.metaDescription}
  path="/voorwaarden"
>
  <TermsPage />
</Base>
