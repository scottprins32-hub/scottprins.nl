---
/**
 * De one-pager: hero → zo werkt het → menukaart (12 live demo's) →
 * configurator → proof → over Scott → FAQ → footer.
 *
 * De `pacing`-props voeren de regel "nooit twee keer achter elkaar
 * hetzelfde kunstje" uit: fade → none → parallax → fade → …
 * ('none' bij demo's die zelf al bewegen — daar is de demo de show).
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import MenuSection from '../components/MenuSection.astro';
import Configurator from '../components/Configurator.astro';
import Showcase from '../components/Showcase.astro';
import Proof from '../components/Proof.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import CartPill from '../components/CartPill.astro';

import DemoAgenda from '../components/demos/DemoAgenda.astro';
import DemoChatbot from '../components/demos/DemoChatbot.astro';
import DemoKaart from '../components/demos/DemoKaart.astro';
import DemoCalculator from '../components/demos/DemoCalculator.astro';
import DemoBestellen from '../components/demos/DemoBestellen.astro';
import DemoReviews from '../components/demos/DemoReviews.astro';
import DemoBeforeAfter from '../components/demos/DemoBeforeAfter.astro';
import DemoIntake from '../components/demos/DemoIntake.astro';
import DemoPortaal from '../components/demos/DemoPortaal.astro';
import DemoMeertalig from '../components/demos/DemoMeertalig.astro';
import DemoScrollvideo from '../components/demos/DemoScrollvideo.astro';
import DemoCadeau from '../components/demos/DemoCadeau.astro';

import {
  demoAgenda,
  demoBeforeAfter,
  demoBestellen,
  demoCadeau,
  demoCalculator,
  demoChatbot,
  demoIntake,
  demoKaart,
  demoMeertalig,
  demoPortaal,
  demoReviews,
  demoScrollvideo,
  menuIntro,
} from '../data/site';
---

<Base>
  <SiteNav />
  <main id="main">
    <Hero />
    <HowItWorks />

    {/* Intro van de menukaart */}
    <section class="bg-cream pt-16 text-ink sm:pt-24" id="menu" data-reveal-section>
      <div class="mx-auto max-w-6xl px-5">
        <header class="max-w-2xl" data-reveal>
          <p class="kicker">{menuIntro.kicker}</p>
          <h2 class="font-display text-h2 mt-2 font-semibold">{menuIntro.title}</h2>
          <p class="text-muted text-lead mt-3">{menuIntro.lead}</p>
        </header>
      </div>
    </section>

    <MenuSection id="menu-booking" index={1} kicker={demoAgenda.kicker} title={demoAgenda.title} lead={demoAgenda.lead} addonIds={['agenda']} pacing="fade">
      <DemoAgenda />
    </MenuSection>

    <MenuSection id="menu-chatbot" index={2} kicker={demoChatbot.kicker} title={demoChatbot.title} lead={demoChatbot.lead} addonIds={['chatbot']} pacing="none">
      <DemoChatbot />
    </MenuSection>

    <MenuSection id="menu-map" index={3} kicker={demoKaart.kicker} title={demoKaart.title} lead={demoKaart.lead} addonIds={['kaart']} pacing="parallax">
      <DemoKaart />
    </MenuSection>

    <MenuSection id="menu-calculator" index={4} kicker={demoCalculator.kicker} title={demoCalculator.title} lead={demoCalculator.lead} addonIds={['calculator']} pacing="fade">
      <DemoCalculator />
    </MenuSection>

    <MenuSection id="menu-ordering" index={5} kicker={demoBestellen.kicker} title={demoBestellen.title} lead={demoBestellen.lead} addonIds={['bestellen']} pacing="none">
      <DemoBestellen />
    </MenuSection>

    <MenuSection id="menu-reviews" index={6} kicker={demoReviews.kicker} title={demoReviews.title} lead={demoReviews.lead} addonIds={['reviews']} pacing="none">
      <DemoReviews />
    </MenuSection>

    <MenuSection id="menu-beforeafter" index={7} kicker={demoBeforeAfter.kicker} title={demoBeforeAfter.title} lead={demoBeforeAfter.lead} addonIds={['beforeafter']} pacing="parallax">
      <DemoBeforeAfter />
    </MenuSection>

    <MenuSection id="menu-intake" index={8} kicker={demoIntake.kicker} title={demoIntake.title} lead={demoIntake.lead} addonIds={['intake']} pacing="fade">
      <DemoIntake />
    </MenuSection>

    <MenuSection id="menu-portal" index={9} kicker={demoPortaal.kicker} title={demoPortaal.title} lead={demoPortaal.lead} addonIds={['portaal']} pacing="parallax">
      <DemoPortaal />
    </MenuSection>

    <MenuSection id="menu-multilingual" index={10} kicker={demoMeertalig.kicker} title={demoMeertalig.en.title} lead={demoMeertalig.en.lead} addonIds={['meertalig']} pacing="fade">
      <DemoMeertalig />
    </MenuSection>

    <MenuSection id="menu-scrollvideo" index={11} kicker={demoScrollvideo.kicker} title={demoScrollvideo.title} lead={demoScrollvideo.lead} addonIds={['scrollvideo']} pacing="none">
      <DemoScrollvideo />
    </MenuSection>

    <MenuSection id="menu-giftcards" index={12} kicker={demoCadeau.kicker} title={demoCadeau.title} lead={demoCadeau.lead} addonIds={['cadeaubonnen']} pacing="parallax">
      <DemoCadeau />
    </MenuSection>

    <Showcase />
    <Configurator />
    <Proof />
    <About />
    <Faq />
  </main>

  <SiteFooter />
  <CartPill />
</Base>

<script>
  import { initCountups, initSectionMotion } from '../scripts/motion';

  initSectionMotion();
  initCountups();
</script>
