---
/**
 * Basis-layout: <head> met SEO, structured data en fonts.
 * Elke pagina wikkelt zichzelf hierin.
 */
import { site } from '../data/site';
import { offer } from '../data/offer';
import { content, toLocale, altPath } from '../data/content';
import { url } from '../lib/url';
import archivo from '../assets/fonts/Archivo-Variable.woff2?url';
import serifItalic from '../assets/fonts/InstrumentSerif-Italic.woff2?url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Taalloos pad voor canonical en hreflang, bijv. '/' of '/privacy'. */
  path?: string;
  /** FAQPage-structured data meesturen (alleen waar de vragen echt staan). */
  faq?: boolean;
  /** Niet indexeren, bijvoorbeeld voor de voorbeeldsites. */
  noindex?: boolean;
  bodyClass?: string;
}

const locale = toLocale(Astro.currentLocale);
const t = content(locale);
const {
  title = t.meta.title,
  description = t.meta.description,
  path = '/',
  faq = false,
  noindex = false,
  bodyClass = '',
} = Astro.props;

/* De preview op GitHub Pages hoort nooit in Google te komen. */
const robots = noindex || import.meta.env.PREVIEW ? 'noindex, nofollow' : undefined;

/* canonical en hreflang komen uit hetzelfde taalloze pad, zodat ze nooit uit
   elkaar kunnen lopen. Altijd het productiedomein. */
const canonical = new URL(altPath(path, locale), site.url).href;
const alternates = [
  { hreflang: 'nl', href: new URL(altPath(path, 'nl'), site.url).href },
  { hreflang: 'en', href: new URL(altPath(path, 'en'), site.url).href },
  { hreflang: 'x-default', href: new URL(altPath(path, 'nl'), site.url).href },
];
const ogImage = new URL('/og.png', site.url).href;

/* '1171 MG Badhoevedorp' → plaats. In de structured data alleen de plaats:
   Scott werkt alleen online en het adres is een woonadres, geen
   bezoekadres. Het volledige adres staat (wettelijk verplicht) in de footer. */
const [, , plaats] = site.addressCity.match(/^(\d{4}\s?[A-Z]{2})\s+(.+)$/) ?? [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#scott`,
      name: site.name,
      jobTitle: locale === 'en' ? 'Web designer' : 'Webdesigner',
      email: site.email,
      url: site.url,
    },
    {
      '@type': ['ProfessionalService', 'LocalBusiness'],
      '@id': `${site.url}/#service`,
      name: site.legalName,
      founder: { '@id': `${site.url}/#scott` },
      url: site.url,
      email: site.email,
      telephone: `+${site.whatsapp}`,
      image: ogImage,
      identifier: { '@type': 'PropertyValue', name: 'KVK', value: '89874994' },
      sameAs: ['https://modernpitching.nl'],
      description: t.meta.description,
      areaServed: [
        { '@type': 'City', name: 'Badhoevedorp' },
        { '@type': 'City', name: 'Hoofddorp' },
        { '@type': 'City', name: 'Amstelveen' },
        { '@type': 'City', name: 'Amsterdam' },
        { '@type': 'Country', name: 'Nederland' },
      ],
      priceRange: `€${offer.price}`,
      knowsLanguage: ['nl', 'en'],
      /* Het aanbod komt uit offer.ts, dus het loopt nooit uit de pas met de pagina. */
      makesOffer: {
        '@type': 'Offer',
        '@id': `${site.url}/#offer`,
        name: locale === 'en' ? 'Custom website' : 'Website op maat',
        description: t.order.slip.detail,
        category: 'Webdesign',
        price: offer.price,
        priceCurrency: offer.currency,
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: offer.price,
          priceCurrency: offer.currency,
          valueAddedTaxIncluded: false,
        },
        seller: { '@id': `${site.url}/#service` },
      },
      ...(plaats
        ? {
            address: {
              '@type': 'PostalAddress',
              addressLocality: plaats,
              addressCountry: 'NL',
            },
          }
        : {}),
    },
    ...(faq
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${canonical}#faq`,
            mainEntity: t.faq.items.map((item) => ({
              '@type': 'Question',
              name: item.q,
              acceptedAnswer: { '@type': 'Answer', text: item.a },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#0b0e11" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'nl_NL'} />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/* De twee lettertypes van de kop: die bepalen de eerste paint. */}
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />

    {/*
      Eén regel die blokkeert, en dat is de bedoeling: de module-scripts
      draaien pas na de eerste paint. Met `.js` op <html> weet de CSS meteen
      dat JavaScript de intro overneemt; zonder JS blijft alles gewoon staan.
    */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link btn btn-signal">{t.nav.skip}</a>
    <slot />
  </body>
</html>
